{%- comment -%}
  Eine Kollektion, etwa /collections/espresso oder /collections/decaf-coffee.
  /collections/all zeigt die Shop-Seite (bw-shop), ihre kanonische Adresse
  ist /collections (bw-kopfdaten).

  Sonst wie die Abschnitte von shop.html: heller Kopf mit Sonne und Wellen
  (Brotkrumen Start · Shop · Kollektion, Titel und Beschreibung aus dem
  Shop, bei Espresso und Filterkaffee der Knopf zur Hub-Seite), Raster mit
  Produktkarten (bw-produkt-karte, 24 je Seite, in der Reihenfolge der
  Kollektion) und das Band zum ganzen Shop.

  Schema: BreadcrumbList und ItemList der Produkte dieser Seite.
{%- endcomment -%}
{%- if collection.handle == 'all' -%}
  {% render 'bw-shop' %}
{%- else -%}
{%- liquid
  assign seite = request.origin | append: collection.url
  assign lead = collection.description | strip_html | strip
  assign hub_url = ''
  if collection.id == collections['espresso'].id and pages['espresso'] != blank
    assign hub_url = pages['espresso'].url
    assign hub_knopf = 'shop.espresso_knopf' | t
  elsif collection.id == collections['filterkaffee'].id and pages['filterkaffee'] != blank
    assign hub_url = pages['filterkaffee'].url
    assign hub_knopf = 'shop.filter_knopf' | t
  endif
-%}
<section class="seitenkopf seitenkopf--hell">
  <div class="hero-himmel" style="position:absolute;inset:0;z-index:0"></div>
  {%- render 'bw-sonne-wellen', teil: 'sonne' %}
  <div class="wrap">
    <nav class="brotkrumen" aria-label="{{ 'produkt.brotkrumen' | t }}">
      <a href="{{ routes.root_url }}">{{ 'produkt.brot_start' | t }}</a><span class="teiler">·</span>
      <a href="{{ routes.collections_url }}">{{ 'kopf.shop' | t }}</a><span class="teiler">·</span>
      <span>{{ collection.title }}</span>
    </nav>
    <span class="eyebrow" style="color:var(--redorange);display:block;margin-top:20px">{{ 'shop.kollektion_eyebrow' | t }}</span>
    <h1 data-split="zeilen" style="max-width:15ch">{{ collection.title }}</h1>
    {%- if lead != blank %}
    <p class="lead">{{ lead }}</p>
    {%- endif %}
    {%- if hub_url != blank %}
    <div class="kopf-aktionen-reihe">
      <a class="btn btn--linie" href="{{ hub_url }}" data-pfeil>{{ hub_knopf }}</a>
    </div>
    {%- endif %}
  </div>
  {%- render 'bw-sonne-wellen', teil: 'wellen' %}
</section>

{%- paginate collection.products by 24 %}
<section class="sektion" style="padding-top:clamp(48px,6vw,80px)">
  <div class="wrap">
    {%- if collection.products.size > 0 %}
    <div class="produkt-raster" data-batch>
      {%- for p in collection.products %}
      {% render 'bw-produkt-karte', p: p %}
      {%- endfor %}
    </div>
    {%- else %}
    <p style="opacity:.7">{{ 'shop.leer' | t }}</p>
    {%- endif %}
    {%- if paginate.pages > 1 %}
    <nav class="bw-blaettern" aria-label="{{ 'shop.blaettern' | t }}">
      {%- if paginate.previous %}
      <a class="btn btn--linie" href="{{ paginate.previous.url }}" rel="prev">{{ 'shop.zurueck' | t }}</a>
      {%- endif %}
      <span>{{ 'allgemein.seite' | t: nummer: paginate.current_page }}</span>
      {%- if paginate.next %}
      <a class="btn btn--linie" href="{{ paginate.next.url }}" rel="next">{{ 'shop.weiter' | t }}</a>
      {%- endif %}
    </nav>
    {%- endif %}
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": {{ 'rezept.schema_start' | t | json }}, "item": {{ request.origin | append: routes.root_url | json }} },
    { "@type": "ListItem", "position": 2, "name": {{ 'kopf.shop' | t | json }}, "item": {{ request.origin | append: routes.collections_url | json }} },
    { "@type": "ListItem", "position": 3, "name": {{ collection.title | json }}, "item": {{ seite | json }} }
  ]
}
</script>
{%- if collection.products.size > 0 %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": [
    {%- for p in collection.products %}
    { "@type": "ListItem", "position": {{ paginate.current_offset | plus: forloop.index }}, "url": {{ request.origin | append: p.url | json }} }{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ]
}
</script>
{%- endif %}
{%- endpaginate %}

<section class="sektion" style="padding-top:0">
  <div class="wrap">
    <div class="hub-band" data-reveal>
      <img class="signet" src="{{ 'logo-hellorange-signet.svg' | asset_url }}" alt="" aria-hidden="true" width="764" height="923">
      <div>
        <span class="eyebrow" style="opacity:.85">{{ 'shop.band_eyebrow' | t }}</span>
        <h2 style="margin-top:14px">{{ 'shop.band_titel_html' | t }}</h2>
        <p>{{ 'shop.band_text' | t }}</p>
      </div>
      <a class="btn btn--hell" href="{{ routes.collections_url }}" data-pfeil>{{ 'shop.band_knopf' | t }}</a>
    </div>
  </div>
</section>
{%- endif %}
{% schema %}
{ "name": "Kollektion", "settings": [] }
{% endschema %}
