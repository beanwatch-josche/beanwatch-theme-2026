{%- comment -%}
  Rezeptübersicht /blogs/kaffeerezepte (Vorlage blog.rezept-template),
  übertragen aus rezepte.html der Werkstatt: heller Kopf mit Sonne und
  Wellen, Filterleiste und Raster, Band zum Shop.

  Das Raster zeigt wie im Prototyp alle Beiträge, «Rezepte» ist nur
  vorgewählt. Liquid zeichnet die Rezeptkarten schon ins HTML (für Google
  und ohne JavaScript), wissen.js zeichnet sie danach aus dem Datenblock
  (bw-beitraege-daten) mit Filterleiste neu. Unveröffentlichte Rezepte
  liefert blog.articles nicht.

  Schema: BreadcrumbList und ItemList der Rezepte. WebSite und
  Organization kommen aus bw-kopfdaten.
{%- endcomment -%}
{%- liquid
  assign seite = request.origin | append: blog.url
-%}
<section class="seitenkopf seitenkopf--hell">
  <div class="hero-himmel" style="position:absolute;inset:0;z-index:0"></div>
  <svg class="kopf-sonne" data-sonne viewBox="0 0 200 200" fill="none" aria-hidden="true">
    <g data-strahlen stroke="#FF4612" stroke-width="3" stroke-linecap="round" opacity=".45">
      <path d="M100.0 34.0L100.0 10.0"/><path d="M126.8 35.3L131.8 23.3"/><path d="M146.7 53.3L163.6 36.4"/><path d="M164.7 73.2L176.7 68.2"/>
      <path d="M166.0 100.0L190.0 100.0"/><path d="M164.7 126.8L176.7 131.8"/><path d="M146.7 146.7L163.6 163.6"/><path d="M126.8 164.7L131.8 176.7"/>
      <path d="M100.0 166.0L100.0 190.0"/><path d="M73.2 164.7L68.2 176.7"/><path d="M53.3 146.7L36.4 163.6"/><path d="M35.3 126.8L23.3 131.8"/>
      <path d="M34.0 100.0L10.0 100.0"/><path d="M35.3 73.2L23.3 68.2"/><path d="M53.3 53.3L36.4 36.4"/><path d="M73.2 35.3L68.2 23.3"/>
    </g>
    <circle data-kern cx="100" cy="100" r="46" fill="#FF4612" opacity=".14"/>
    <circle cx="100" cy="100" r="46" stroke="#FF4612" stroke-width="2.5" opacity=".5"/>
  </svg>
  <div class="wrap">
    <nav class="brotkrumen" aria-label="{{ 'rezept.brotkrumen' | t }}">
      <a href="{{ routes.root_url }}">{{ 'rezept.brot_start' | t }}</a><span class="teiler">·</span>
      {%- if blogs['kaffeewissen'] != blank %}
      <a href="{{ blogs['kaffeewissen'].url }}">{{ 'rezept.brot_wissen' | t }}</a><span class="teiler">·</span>
      {%- endif %}
      <span>{{ 'rezept.brot_rezepte' | t }}</span>
    </nav>
    <span class="eyebrow" style="color:var(--redorange);display:block;margin-top:20px">{{ 'rezepte.eyebrow' | t }}</span>
    <h1 data-split="zeilen" style="max-width:16ch">{{ 'rezepte.titel' | t }}</h1>
    <p class="lead">{{ 'rezepte.lead' | t }}</p>
  </div>
  {%- comment -%} Drei Schichten Cyanblau, 32 %, 55 % und deckend, wie im Hero der Startseite. {%- endcomment %}
  <div class="kopf-wellen" data-wellen aria-hidden="true">
    <svg class="welle-hinten" viewBox="0 0 2880 120" preserveAspectRatio="none">
      <path d="M0,62 C240,30 480,94 720,62 C960,30 1200,94 1440,62 C1680,30 1920,94 2160,62 C2400,30 2640,94 2880,62 L2880,120 L0,120 Z" fill="#4FC4E2"/>
    </svg>
    <svg class="welle-mitte" viewBox="0 0 2880 120" preserveAspectRatio="none">
      <path d="M0,80 C240,54 480,106 720,80 C960,54 1200,106 1440,80 C1680,54 1920,106 2160,80 C2400,54 2640,106 2880,80 L2880,120 L0,120 Z" fill="#4FC4E2"/>
    </svg>
    <svg class="welle-vorne" viewBox="0 0 2880 120" preserveAspectRatio="none">
      <path d="M0,98 C240,80 480,116 720,98 C960,80 1200,116 1440,98 C1680,80 1920,116 2160,98 C2400,80 2640,116 2880,98 L2880,120 L0,120 Z" fill="#4FC4E2"/>
    </svg>
  </div>
</section>

<section class="sektion" style="padding-top:clamp(40px,5vw,72px)">
  <div class="wrap">
    <div class="filterleiste" id="filterleiste"></div>
    <div class="beitraege" id="beitraege-raster">
      {%- for a in blog.articles -%}
        {% render 'bw-beitrag', a: a, art: 'rezept' %}
      {%- else -%}
        <p style="opacity:.7">{{ 'beitraege.leer' | t }}</p>
      {%- endfor -%}
    </div>
  </div>
</section>

<section class="sektion" style="padding-top:0">
  <div class="wrap">
    <div class="hub-band" data-reveal>
      <img class="signet" src="{{ 'logo-hellorange-signet.svg' | asset_url }}" alt="" aria-hidden="true" width="764" height="923">
      <div>
        <span class="eyebrow" style="opacity:.85">{{ 'rezepte.band_eyebrow' | t }}</span>
        <h2 style="margin-top:14px">{{ 'rezepte.band_titel_html' | t }}</h2>
        <p>{{ 'rezepte.band_text' | t }}</p>
      </div>
      <a class="btn btn--hell" href="{{ routes.all_products_collection_url }}" data-pfeil>{{ 'rezepte.band_knopf' | t }}</a>
    </div>
  </div>
</section>

{% render 'bw-beitraege-daten' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": {{ 'rezept.schema_start' | t | json }}, "item": {{ request.origin | append: routes.root_url | json }} },
    {%- if blogs['kaffeewissen'] != blank %}
    { "@type": "ListItem", "position": 2, "name": {{ blogs['kaffeewissen'].title | json }}, "item": {{ request.origin | append: blogs['kaffeewissen'].url | json }} },
    { "@type": "ListItem", "position": 3, "name": {{ blog.title | json }}, "item": {{ seite | json }} }
    {%- else %}
    { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ seite | json }} }
    {%- endif %}
  ]
}
</script>
{%- if blog.articles_count > 0 %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": [
    {%- for a in blog.articles %}
    { "@type": "ListItem", "position": {{ forloop.index }}, "url": {{ request.origin | append: a.url | json }} }{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ]
}
</script>
{%- endif %}

<script src="{{ 'wissen.js' | asset_url }}" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (window.BWWissen) BWWissen.raster('#beitraege-raster', '#filterleiste', 'art:rezept');
  });
</script>

{% schema %}
{ "name": "Rezeptübersicht", "settings": [] }
{% endschema %}
