{%- render 'bw-rohbau-kopf', eyebrow: shop.name, titel: blog.title -%}
<section class="sektion">
  <div class="wrap">
    {%- paginate blog.articles by 24 %}
    <ul class="bw-rohbau-raster">
      {%- for a in blog.articles %}
      <li>
        <a href="{{ a.url }}">
          {%- if a.image %}{{ a.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: a.title }}{% endif %}
          <span class="bw-rohbau-titel">{{ a.title }}</span>
          <span class="bw-rohbau-datum">{{ a.published_at | date: format: 'date' }}</span>
        </a>
      </li>
      {%- else %}
      <li>{{ 'rohbau.leer' | t }}</li>
      {%- endfor %}
    </ul>
    {%- if paginate.pages > 1 %}{{ paginate | default_pagination }}{% endif %}
    {%- endpaginate %}
  </div>
</section>
{% schema %}
{ "name": "Blog (Rohbau)", "settings": [] }
{% endschema %}
