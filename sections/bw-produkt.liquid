{%- comment -%}
  Produktseite für alles ausser Kaffee (Vorlage product, seit 0.6.0), heute
  das Buch «Kaffee Erlebnis Schweiz», übertragen aus
  products/kaffee-erlebnis-schweiz.html der Werkstatt. Die Kaffees haben
  eigene Vorlagen (bw-produkt-kaffee), das Probierset bekommt eine eigene.

  Woher die Inhalte kommen (Felder seit 07.10.2026):
    Kopf          Galerie aus den Produktbildern (bw-galerie), Zeile über
                  dem Titel custom.kopfzeile, die Produktbeschreibung im
                  Shop-Wortlaut (mit Fakten nur der erste Absatz, beim Buch
                  stehen im zweiten die Buchdaten), Preis mit
                  custom.preis_zusatz, Knopf custom.weiterlesen (link),
                  darunter die Zeile custom.seitenbox_titel und _text,
                  Karte «Leseprobe aus dem Buch» aus custom.leseprobe (seit
                  0.6.1, beim Buch das Kapitel zur Kaffeegeschichte), sonst
                  «Passt gut dazu» aus custom.passt_artikel
    Fakten        custom.fakten (Metaobjekte produktfakt: rolle, wert),
                  darunter «Für wen:» custom.fuer_wen
    Siegel        der erste Eintrag aus custom.auszeichnungen (seit 0.20.0)
                  auf dem Hauptbild (bw-siegel): Silber beim Swiss Gourmet
                  Book Award als dessen Band oben rechts (seit 0.21.0),
                  sonst das runde Siegel unten rechts
    Ausgezeichnet custom.auszeichnungen (Metaobjekte auszeichnung: titel,
                  jahr, stufe, kategorie, text, bild, link) als Bildblock,
                  der erste gedreht; ohne bild steht das Zeichen gross im
                  Bildfeld. Titel aus Stufe, Preis und Jahr
    Bildblöcke    custom.bildbloecke (Metaobjekte bildblock: anker, eyebrow,
                  titel, text, bild, pillen), jeder zweite gedreht
    Anlässe       custom.anlaesse (seit 0.20.0, Metaobjekte anlass: titel,
                  datum, ort, text, bilder, fotograf), beim Buch die
                  Vernissagen: je ein Fotoraster, Antippen vergrössert
                  (produkt.js fotos(), Wörter aus data-text-*)
    Autor         custom.autor_name, _text (Rich Text), _bild
    Passt dazu    Wissensartikel zum Thema aus der Sektionseinstellung
  Seit 0.7.0 (07.10.2026, Entscheid Joscha) steht die Beschreibung wie im
  Live-Shop im Kopf. kurzbeschrieb und geschichte_titel bleiben im Shop,
  erscheinen aber nicht mehr; die Story-Sektion mit Inhaltsverzeichnis ist
  weg, die Seitenbox ist die Zeile unter dem Knopf.

  Fehlt ein Feld, fällt sein Teil weg, ohne leere Überschrift. Verweise auf
  Artikel erscheinen nur, wenn der Artikel veröffentlicht ist, und zeigen
  auf die Adresse in der Sprache der Seite.

  Schema: bw-produkt-schema (Product, beim Buch auch Book, award aus den
  Auszeichnungen).
{%- endcomment -%}
{%- liquid
  assign mf = product.metafields.custom

  assign ids = product.collections | map: 'id'
  assign ist_buch = false
  if collections['bucher'] != blank and ids contains collections['bucher'].id
    assign ist_buch = true
  endif

  assign fakten = mf.fakten.value
  assign bloecke = mf.bildbloecke.value
  assign auszeichnungen = mf.auszeichnungen.value
  assign anlaesse = mf.anlaesse.value

  # Beim Buch stehen im zweiten Absatz der Beschreibung die Buchdaten; die
  # zeigt das Faktenraster, der Kopf nimmt deshalb nur den ersten.
  assign geschichte = product.description | strip
  if fakten.size > 0 and geschichte contains '</p>'
    assign geschichte = geschichte | split: '</p>' | first | append: '</p>'
  endif

  # Zweiter Knopf (Typ link, Shopify verlangt eine ganze Adresse). Zeigt er
  # auf einen Artikel (/blogs/…), kommt die Adresse aus articles[…]: in der
  # Sprache der Seite und nur, wenn der Artikel veröffentlicht ist.
  assign weiter = mf.weiterlesen.value
  assign weiter_url = ''
  assign weiter_text = ''
  if weiter != blank
    assign weiter_url = weiter.url
    assign weiter_text = weiter.text
    if weiter_url contains '/blogs/'
      assign pfad = weiter_url | split: '/blogs/' | last | split: '?' | first | split: '#' | first
      assign artikel = articles[pfad]
      if artikel != blank
        assign weiter_url = artikel.url
      else
        assign weiter_url = ''
      endif
    endif
  endif

  # Die Karte unter dem Kauf: zuerst eine Leseprobe (ein Artikel, der aus
  # dem Produkt stammt, Entscheid 07.10.2026), sonst «Passt gut dazu».
  assign karte = ''
  assign karte_rolle = 'produkt.partner' | t
  assign karte_hin = 'produkt.ansehen' | t
  if mf.leseprobe.value != blank
    assign karte = articles[mf.leseprobe.value]
    if ist_buch
      assign karte_rolle = 'produkt.leseprobe_buch' | t
    else
      assign karte_rolle = 'produkt.leseprobe' | t
    endif
    assign karte_hin = 'produkt.kostenlos_lesen' | t
  endif
  if karte == blank and mf.passt_artikel.value != blank
    assign karte = articles[mf.passt_artikel.value]
    assign karte_rolle = 'produkt.partner' | t
    assign karte_hin = 'produkt.ansehen' | t
  endif

  # Zeile unter dem Knopf: Titel mit Punkt, ausser er endet schon auf einem
  # Satzzeichen.
  assign hinweis_titel = mf.seitenbox_titel.value | strip
  if hinweis_titel != blank
    assign letztes = hinweis_titel | slice: -1, 1
    unless '.!?:' contains letztes
      assign hinweis_titel = hinweis_titel | append: '.'
    endunless
  endif
  assign themen = section.settings.themen | default: 'grundlagen' | remove: ' ' | split: ','
-%}

<section class="produktkopf">
  <div class="wrap">
    <nav class="brotkrumen" aria-label="{{ 'produkt.brotkrumen' | t }}">
      <a href="{{ routes.root_url }}">{{ 'produkt.brot_start' | t }}</a><span class="teiler">·</span>
      <a href="{{ routes.collections_url }}">{{ 'kopf.shop' | t }}</a><span class="teiler">·</span>
      <span>{{ product.title }}</span>
    </nav>

    <div class="produktkopf-raster">
      {%- comment -%}
        Der erste Eintrag über eine Schleife: auszeichnungen.first lieferte in
        Shopify nichts (0.21.1), das Siegel stand dann leer da.
      {%- endcomment -%}
      {%- capture siegel -%}
        {%- for a in auszeichnungen limit: 1 -%}
          <div class="galerie-siegel">{% render 'bw-siegel', a: a %}</div>
        {%- endfor -%}
      {%- endcapture -%}
      {%- render 'bw-galerie', p: product, siegel: siegel %}

      <div class="produkt-kauf">
        {%- if mf.kopfzeile.value != blank %}
        <span class="herkunftszeile">{{ mf.kopfzeile.value }}</span>
        {%- endif %}
        <h1 data-split="zeilen">{{ product.title }}</h1>
        {%- if geschichte != blank %}
        <div class="produkt-beschreibung">{{ geschichte }}</div>
        {%- endif %}

        {% render 'bw-kaufwahl', p: product, zusatz: mf.preis_zusatz.value, link_url: weiter_url, link_text: weiter_text %}
        {%- if hinweis_titel != blank %}
        <p class="kaufhinweis"><strong>{{ hinweis_titel | escape }}</strong>{% if mf.seitenbox_text.value != blank %} {{ mf.seitenbox_text.value | escape | newline_to_br }}{% endif %}</p>
        {%- endif %}

        {%- if karte != blank %}
        <a class="schwester" href="{{ karte.url }}">
          {%- if karte.image %}
          {{ karte.image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
          {%- endif %}
          <span class="text">
            <span class="rolle">{{ karte_rolle }}</span>
            <h4>{{ karte.metafields.custom.kurztitel.value | default: karte.title }}</h4>
          </span>
          <span class="hin">{{ karte_hin }}
            <svg class="pfeil" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
        </a>
        {%- endif %}
      </div>
    </div>
  </div>
</section>

{%- if fakten.size > 0 or mf.fuer_wen.value != blank %}
<section class="sektion" style="padding-block:clamp(30px,4vw,52px)">
  <div class="wrap">
    {%- if fakten.size > 0 %}
    <div class="fakten" data-batch>
      {%- for f in fakten %}
      <div class="fakt"><span class="rolle">{{ f.rolle.value }}</span><span class="wert">{{ f.wert.value }}</span></div>
      {%- endfor %}
    </div>
    {%- endif %}
    {%- if mf.fuer_wen.value != blank %}
    <div class="merksatz">
      <strong>{{ 'produkt.fuer_wen' | t }}</strong> {{ mf.fuer_wen.value | escape | newline_to_br }}
    </div>
    {%- endif %}
  </div>
</section>
{%- endif %}

{%- comment -%}
  Ausgezeichnet: je Auszeichnung ein Bildblock, der erste gedreht, weil der
  erste Bildblock darunter das Bild links hat. Ein Link auf eine fremde
  Seite öffnet in einem neuen Tab.
{%- endcomment -%}
{%- for a in auszeichnungen %}
{%- liquid
  assign stufe = a.stufe.value | strip
  assign preis = a.titel.value | strip
  if stufe != blank
    assign titel = 'produkt.auszeichnung_titel' | t: stufe: stufe, preis: preis, jahr: a.jahr.value
  else
    assign titel = preis | append: ' ' | append: a.jahr.value | escape
  endif
  assign link = a.link.value
  assign fremd = true
  if link.url contains 'beanwatch.ch' or link.url contains request.host
    assign fremd = false
  endif
-%}
<section class="sektion" id="auszeichnung{% unless forloop.first %}-{{ forloop.index }}{% endunless %}" style="padding-top:0">
  <div class="wrap">
    <div class="bildblock{% cycle 'auszeichnung': ' bildblock--gedreht', '' %}" data-reveal>
      {%- if a.bild.value != blank %}
      {%- render 'bw-produkt-bild', bild: a.bild.value %}
      {%- else %}
      <div class="bildblock-bild auszeichnung-feld">
        {% render 'bw-siegel', a: a, gross: true %}
      </div>
      {%- endif %}
      <div>
        <span class="eyebrow">{{ 'produkt.eyebrow_auszeichnung' | t }}</span>
        <h3>{{ titel }}</h3>
        {%- render 'bw-absaetze', text: a.text.value %}
        {%- if link.url != blank and link.text != blank %}
        <a class="besser-alle" href="{{ link.url }}"{% if fremd %} target="_blank" rel="noopener"{% endif %} data-pfeil>{{ link.text | escape }}</a>
        {%- endif %}
      </div>
    </div>
  </div>
</section>
{%- endfor %}

{%- for b in bloecke %}
<section class="sektion" id="{{ b.anker.value | handleize }}"{% unless forloop.first %} style="padding-top:0"{% endunless %}>
  <div class="wrap">
    <div class="bildblock{% cycle '', ' bildblock--gedreht' %}" data-reveal>
      {%- render 'bw-produkt-bild', bild: b.bild.value %}
      <div>
        {%- if b.eyebrow.value != blank %}
        <span class="eyebrow">{{ b.eyebrow.value }}</span>
        {%- endif %}
        <h3>{{ b.titel.value }}</h3>
        {%- render 'bw-absaetze', text: b.text.value %}
        {%- assign pillen = b.pillen.value %}
        {%- if pillen.size > 0 %}
        <div style="display:flex;gap:9px;flex-wrap:wrap;margin-top:22px">
          {%- for n in pillen %}<span class="pill">{{ n }}</span>{% endfor -%}
        </div>
        {%- endif %}
      </div>
    </div>
  </div>
</section>
{%- endfor %}

{%- comment -%}
  Anlässe, beim Buch die Vernissagen. Pro Anlass Datum · Ort, Titel, Text,
  Fotoraster und «Fotos: …». Die Fotos öffnet produkt.js fotos() gross,
  in derselben Reihenfolge wie im Raster.
{%- endcomment -%}
{%- if anlaesse.size > 0 %}
<section class="sektion anlaesse" id="vernissagen" style="padding-top:0" data-text-dialog="{{ 'produkt.foto_dialog' | t }}" data-text-zurueck="{{ 'produkt.foto_zurueck' | t }}" data-text-weiter="{{ 'produkt.foto_weiter' | t }}" data-text-schliessen="{{ 'produkt.foto_schliessen' | t }}">
  <div class="wrap">
    <div class="sektion-kopf">
      <div class="text">
        <span class="eyebrow">{{ 'produkt.eyebrow_anlaesse' | t }}</span>
        <h2 data-split="zeilen">{{ 'produkt.anlaesse_titel_html' | t }}</h2>
      </div>
    </div>
    {%- for a in anlaesse %}
    {%- assign datum = a.datum.value %}
    {%- assign ort = a.ort.value | strip %}
    {%- assign fotos = a.bilder.value %}

    <article class="anlass" data-reveal>
      <div class="anlass-kopf">
        {%- if datum != blank or ort != blank %}
        <p class="anlass-meta">
          {%- if datum != blank %}<time datetime="{{ datum | date: '%Y-%m-%d' }}">{% render 'bw-datum', datum: datum %}</time>{% endif %}
          {%- if datum != blank and ort != blank %}<span class="teiler">·</span>{% endif %}
          {%- if ort != blank %}<span>{{ ort | escape }}</span>{% endif -%}
        </p>
        {%- endif %}
        <h3>{{ a.titel.value | escape }}</h3>
        {%- render 'bw-absaetze', text: a.text.value %}
      </div>
      {%- if fotos.size > 0 %}
      <div class="anlass-bilder">
        {%- for f in fotos %}
        {%- assign alt = f.alt | default: a.titel.value %}
        <button type="button" class="anlass-bild" data-gross="{{ f | image_url: width: 2000 }}" aria-label="{{ 'produkt.foto_gross' | t }}: {{ alt | escape }}">
          {{ f | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 700, 1000', sizes: '(min-width: 861px) 33vw, 78vw', alt: alt }}
        </button>
        {%- endfor %}
      </div>
      {%- endif %}
      {%- if a.fotograf.value != blank %}
      <p class="anlass-fotos">{{ 'produkt.fotos_von' | t: name: a.fotograf.value }}</p>
      {%- endif %}
    </article>
    {%- endfor %}
  </div>
</section>
{%- endif %}

{%- if mf.autor_name.value != blank %}
<section class="sektion" id="autor"{% if bloecke.size > 0 %} style="padding-top:0"{% endif %}>
  <div class="wrap wrap--inhalt">
    <div class="autorbox" data-reveal style="border-top:0;padding-top:0">
      {%- if mf.autor_bild.value != blank %}
      <div class="portrait">
        {{ mf.autor_bild.value | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 400', sizes: '140px', alt: mf.autor_bild.value.alt }}
      </div>
      {%- endif %}
      <div>
        <span class="rolle">{{ 'produkt.autor_rolle' | t }}</span>
        <h3>{{ mf.autor_name.value }}</h3>
        {%- if mf.autor_text.value != blank %}{{ mf.autor_text | metafield_tag }}{% endif %}
      </div>
    </div>
  </div>
</section>
{%- endif %}

<section class="sektion verwandt">
  <div class="wrap">
    <div class="sektion-kopf">
      <div class="text">
        <span class="eyebrow">{{ 'produkt.passt_eyebrow' | t }}</span>
        <h2 data-split="zeilen">{{ 'produkt.weiterlesen_titel_html' | t }}</h2>
      </div>
      {%- if blogs['kaffeewissen'] != blank %}
      <a class="btn btn--linie" href="{{ blogs['kaffeewissen'].url }}" data-pfeil>{{ 'produkt.alles_wissen' | t }}</a>
      {%- endif %}
    </div>
    <div class="beitraege" id="verwandt-raster">
      {%- render 'bw-verwandte', themen: themen, anzahl: 3, art: 'wissen' -%}
    </div>
  </div>
</section>

{% render 'bw-beitraege-daten' %}
{% render 'bw-produkt-schema', p: product, buch: ist_buch %}

<script src="{{ 'produkt.js' | asset_url }}" defer></script>
<script src="{{ 'wissen.js' | asset_url }}" defer></script>
<script src="{{ 'beitrag.js' | asset_url }}" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (window.BWProdukt) BWProdukt.start();
    if (window.BWBeitrag) BWBeitrag.verwandte('#verwandt-raster', {{ themen | json }}, 3, null, 'wissen');
  });
</script>

{% schema %}
{
  "name": "Produkt (Buch, Zubehör)",
  "settings": [
    { "type": "text", "id": "themen", "label": "Themen für «Passt dazu»", "info": "Durch Kommas getrennt, etwa grundlagen oder espresso,milch. Gezeigt werden Wissensartikel.", "default": "grundlagen" }
  ]
}
{% endschema %}
