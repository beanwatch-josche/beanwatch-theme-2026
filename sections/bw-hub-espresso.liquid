{% render 'bw-hub-schema' %}

{{ 'faehren.css' | asset_url | stylesheet_tag }}
<script src="{{ 'faehren.js' | asset_url }}" defer></script>
<script src="{{ 'hubs.js' | asset_url }}" defer></script>
<script src="{{ 'atmosphaere.js' | asset_url }}" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (!window.BWHub) return;
    BWHub.espresso();
    BWHub.klappRaster('#routine-raster', '#routine-mehr', { hart: true });
    BWHub.schritteBand('#routine-raster', '#routine-pfeile');
    BWHub.getraenkeFilter('#getraenke-raster', '#getraenke-filter', '#getraenke-mehr');
    BWHub.baristaRaster('#barista-raster');
    // Aufklappen erst ab drei Guide-Karten, wie im Prototyp.
    BWHub.klappRaster('#barista-raster', '#barista-mehr', {
      gilt: function () { return document.querySelectorAll('#barista-raster > .brewguide').length > 2; }
    });
  });
</script>

{% schema %}
{
  "name": "Espresso-Hub",
  "settings": [
    { "type": "header", "content": "Fotos der Espresso-Routine" },
    { "type": "paragraph", "content": "Platzhalter aus den Rezepten, bis es eigene Aufnahmen gibt. Den Ausschnitt setzt der Fokuspunkt des Bildes." },
    { "type": "image_picker", "id": "routine_bild_1", "label": "Schritt 1: Aufheizen und spülen" },
    { "type": "image_picker", "id": "routine_bild_2", "label": "Schritt 2: Mahlen und wiegen" },
    { "type": "image_picker", "id": "routine_bild_3", "label": "Schritt 3: Verteilen und tampern" },
    { "type": "image_picker", "id": "routine_bild_4", "label": "Schritt 4: Einspannen und starten" },
    { "type": "image_picker", "id": "routine_bild_5", "label": "Schritt 5: Wiegen, probieren, anpassen" },
    { "type": "header", "content": "Tiefer rein" },
    { "type": "article_list", "id": "artikel", "label": "Artikel", "limit": 3, "info": "Leer: Flat White, Welche Milch und Café Crème wie im Prototyp, sonst die neusten Wissensartikel zum Thema Espresso." }
  ]
}
