{%- comment -%}
  Der Filterkaffee-Hub (seit 0.9.0), Vorlage page.filterkaffee, übertragen
  aus filterkaffee.html der Werkstatt: Markup, Klassen und IDs wie dort,
  denn hubs.js (Rechner, Routine, Rettungsarm mit V60) und seiten.css
  brauchen sie. Feste Texte aus den Sprachdateien (hub, hub_filter), die
  Sätze des Rechners als data-text-* für hubs.js, die sieben Charaktere des
  Brühverhältnisses als data-charakter an den Stufen.

  Woher die Inhalte kommen:
    Kopf, Wegweiser, Grundrezept, Routine, Band   Sprachdateien; die fünf
                  Routine-Fotos sind Einstellungen der Sektion
    02 Bohnen     die Kollektion filterkaffee, ganz und in Shop-Reihenfolge
    03 Rezepte    veröffentlichte Rezepte aus kaffeerezepte mit dem Thema
                  filter (custom.themen): Cold Brew und Cold Brew Tonic
    04 Methoden   die Box zum Methodenfinder, wenn es die Seite
                  welche-filtermethode gibt; die Guide-Karten hängt hubs.js
                  an, sobald Brew Guides veröffentlicht sind
    05 Wissen     die Artikel der Einstellung «Artikel», sonst die neusten
                  Wissensartikel zum Thema filter. Heute gibt es keinen, der
                  Abschnitt fehlt also wie im Start-Modus des Prototyps.
    Gut zu wissen «Was ist Filterkaffee?» und die FAQ (bw-hub-fragen)
  Fehlt ein Abschnitt, fällt auch seine Station weg, die Nummern zählen
  weiter. Links auf Tools, Finder und Artikel nur zu Veröffentlichtem.
{%- endcomment -%}
{%- liquid
  assign dez = 'rezept.dezimal' | t
  # Platzhalter für hubs.js. Eine «}» in einem Text beendet in Shopify das
  # Ausgabe-Tag zu früh, deshalb stehen sie hier und nicht dort.
  assign platz_n = '{n}'
  assign platz_v = '{v}'

  # 02 Bohnen
  assign kollektion = collections['filterkaffee']
  assign n_bohnen = 0
  if kollektion != blank
    assign n_bohnen = kollektion.products.size
  endif

  # 03 Rezepte
  assign n_rezepte = 0
  capture rezepte
    if blogs['kaffeerezepte'] != blank
      for a in blogs['kaffeerezepte'].articles
        if a.metafields.custom.themen.value contains 'filter'
          render 'bw-rezept-kachel', a: a
          assign n_rezepte = n_rezepte | plus: 1
        endif
      endfor
    endif
  endcapture

  # 04 Methoden
  assign finder = pages['welche-filtermethode']
  assign hat_guides = false
  if blogs['brew-guides'] != blank
    assign n_guides = blogs['brew-guides'].articles_count | plus: 0
    if n_guides > 0
      assign hat_guides = true
    endif
  endif
  assign hat_methoden = false
  if finder != blank or hat_guides
    assign hat_methoden = true
  endif

  # 05 Wissen
  capture wissen
    if section.settings.artikel != blank and section.settings.artikel.size > 0
      for a in section.settings.artikel limit: 3
        render 'bw-beitrag', a: a, art: 'wissen'
      endfor
    else
      assign themen = 'filter' | split: ','
      render 'bw-verwandte', themen: themen, anzahl: 3, art: 'wissen'
    endif
  endcapture
  assign wissen = wissen | strip

  # Ziele für «Tiefer rein» in der Routine
  assign seite_wasser = pages['wasserhaerte']
  assign seite_koffein = pages['koffeinrechner']
  assign artikel_koffein = articles['kaffeewissen/koffein-im-kaffee-wie-viel-steckt-drin-wie-wirkt-es-und-wie-lange-halt-es-an']

  # Nummern der Abschnitte, lückenlos
  assign nr = 1
  assign nr_bohnen = 0
  assign nr_rezepte = 0
  assign nr_methoden = 0
  assign nr_wissen = 0
  if n_bohnen > 0
    assign nr = nr | plus: 1
    assign nr_bohnen = nr
  endif
  if n_rezepte > 0
    assign nr = nr | plus: 1
    assign nr_rezepte = nr
  endif
  if hat_methoden
    assign nr = nr | plus: 1
    assign nr_methoden = nr
  endif
  if wissen != blank
    assign nr = nr | plus: 1
    assign nr_wissen = nr
  endif

  capture anzahl_wort
    render 'bw-zahlwort', n: n_bohnen
  endcapture
  assign anzahl_wort = anzahl_wort | strip
  assign anzahl_gross = anzahl_wort | capitalize

  # Das Brühverhältnis wie FILTER_VERHAELTNIS in hubs.js, Stufe 4 vorgewählt
  assign stufen = '14,15,16,16.7,17,18,20' | split: ','
  assign zu = 'hub_filter.zu' | t
  assign start_charakter = 'hub_filter.charakter_4' | t
  assign erster = start_charakter | slice: 0 | downcase
  assign rest = start_charakter | slice: 1, 200
-%}

{%- capture spur -%}<div class="szene-spur tasse-spur"></div>
    <div class="szene-spur arm-spur"></div>{%- endcapture -%}
<section class="seitenkopf seitenkopf--hell seitenkopf--wasser" id="kopf-filter">
  <div class="hero-himmel" style="position:absolute;inset:0;z-index:0"></div>
  {% render 'bw-sonne-wellen', teil: 'sonne' %}
  <div class="wrap">
    <div>
      <nav class="brotkrumen" aria-label="{{ 'rezept.brotkrumen' | t }}">
        <a href="{{ routes.root_url }}">{{ 'rezept.brot_start' | t }}</a><span class="teiler">·</span><span>{{ page.title | escape }}</span>
      </nav>
      <span class="eyebrow" style="color:var(--redorange);display:block;margin-top:20px">{{ 'hub_filter.eyebrow' | t }}</span>
      <h1 data-split="zeilen">{{ 'hub_filter.titel_html' | t }}</h1>
      <p class="lead">{{ 'hub_filter.lead' | t }}</p>
      <div class="kopf-aktionen-reihe">
        <a class="btn btn--primaer" href="#rezeptur" data-pfeil>{{ 'hub.zum_grundrezept' | t }}</a>
        {%- if n_bohnen > 0 %}
        <a class="btn btn--linie" href="#bohnen">{{ 'hub_filter.knopf_bohnen' | t }}</a>
        {%- endif %}
      </div>
    </div>
  </div>
  {% render 'bw-sonne-wellen', teil: 'wellen', spur: spur %}
</section>

<section class="sektion" id="wegweiser" style="padding-top:clamp(48px,6vw,84px)">
  <div class="wrap">
    <div class="sektion-kopf">
      <div class="text">
        <span class="eyebrow">{{ 'hub.wegweiser_eyebrow' | t }}</span>
        <h2 class="titel-breit" data-split="zeilen">{{ 'hub_filter.wegweiser_titel_html' | t }}</h2>
        <p>{{ 'hub.wegweiser_text' | t }}</p>
      </div>
    </div>

    <ol class="wegweiser" role="list" data-batch>
      {%- assign t1 = 'hub.station_rezept_titel' | t -%}
      {%- assign t2 = 'hub_filter.station_rezept_satz' | t -%}
      {%- render 'bw-hub-station', ziel: '#rezeptur', icon: 'rezeptur-filter', titel: t1, satz: t2 -%}
      {%- if n_bohnen > 0 -%}
        {%- assign t1 = 'hub_filter.station_bohnen_titel' | t -%}
        {%- if n_bohnen == 1 -%}
          {%- assign t2 = 'hub_filter.station_bohnen_satz_eins' | t -%}
        {%- else -%}
          {%- assign t2 = 'hub_filter.station_bohnen_satz' | t: anzahl: anzahl_gross -%}
        {%- endif -%}
        {%- render 'bw-hub-station', ziel: '#bohnen', icon: 'bohne', titel: t1, satz: t2 -%}
      {%- endif -%}
      {%- if n_rezepte > 0 -%}
        {%- assign t1 = 'hub_filter.station_rezepte_titel' | t -%}
        {%- assign t2 = 'hub_filter.station_rezepte_satz' | t -%}
        {%- render 'bw-hub-station', ziel: '#rezepte', icon: 'coldbrew', titel: t1, satz: t2 -%}
      {%- endif -%}
      {%- if hat_methoden -%}
        {%- assign t1 = 'hub_filter.station_methoden_titel' | t -%}
        {%- if hat_guides -%}
          {%- assign t2 = 'hub_filter.station_methoden_satz_guides' | t -%}
        {%- else -%}
          {%- assign t2 = 'hub_filter.station_methoden_satz' | t -%}
        {%- endif -%}
        {%- render 'bw-hub-station', ziel: '#brewguides', icon: 'methode', titel: t1, satz: t2 -%}
      {%- endif -%}
      {%- if wissen != blank -%}
        {%- assign t1 = 'hub.station_wissen_titel' | t -%}
        {%- assign t2 = 'hub_filter.station_wissen_satz' | t -%}
        {%- render 'bw-hub-station', ziel: '#filter-wissen', icon: 'wissen', titel: t1, satz: t2 -%}
      {%- endif -%}
    </ol>
  </div>
</section>

<section class="sektion" id="rezeptur" style="background:var(--dunkelblau);color:var(--hellorange)">
  <div class="atmo" data-atmo="tropfen" aria-hidden="true"></div>
  <div class="wrap">
    <div class="sektion-kopf">
      <div class="text">
        <span class="eyebrow" style="color:var(--cyanblau)">01 · {{ 'hub.grundrezept' | t }}</span>
        <h2 data-split="zeilen">{{ 'hub_filter.rezeptur_titel_html' | t }}</h2>
      </div>
      <p style="opacity:.86">{{ 'hub_filter.rezeptur_text' | t }}</p>
    </div>

    <div class="rezeptur-fluss rezeptur-fluss--breit" id="filter-rezeptur"
         data-text-dezimal="{{ dez }}"
         data-text-gramm="{{ 'hub.gramm' | t: n: platz_n }}"
         data-text-liter="{{ 'hub_filter.liter' | t: n: platz_n }}"
         data-text-zu="{{ zu }}"
         data-text-hinweis-hell="{{ 'hub_filter.hinweis_hell' | t }}"
         data-text-hinweis-dunkel="{{ 'hub_filter.hinweis_dunkel' | t }}"
         data-text-bloom="{{ 'hub_filter.bloom' | t: n: platz_n }}"
         data-text-guss="{{ 'hub_filter.guss' | t: n: platz_n }}"
         data-text-satz-hell="{{ 'hub_filter.satz_hell' | t: v: platz_v }}"
         data-text-satz-dunkel="{{ 'hub_filter.satz_dunkel' | t: v: platz_v }}">

      <div class="rezeptur-ergebnis rezeptur-ergebnis--breit" data-reveal>
        <span class="eyebrow">{{ 'hub.dein_rezept' | t }}</span>

        <div class="rezeptur" aria-live="polite">
          <div class="rezeptur-wert">
            <span class="zahl" id="filter-wert-mehl"></span>
            <span class="rolle">{{ 'hub.kaffeemehl' | t }}</span>
          </div>
          <div class="rezeptur-wert">
            <span class="zahl" id="filter-wert-wasser"></span>
            <span class="rolle">{{ 'hub_filter.wasser' | t }}</span>
          </div>
          <div class="rezeptur-wert">
            <span class="zahl" id="filter-wert-bloom"></span>
            <span class="rolle">{{ 'hub_filter.blooming' | t }}</span>
          </div>
          <div class="rezeptur-wert">
            <span class="zahl" id="filter-wert-temperatur"></span>
            <span class="rolle">{{ 'hub_filter.temperatur' | t }}</span>
          </div>
        </div>

        <div class="rezeptur-regler">
          <p class="rezeptur-regler-satz">{{ 'hub_filter.regler_satz' | t }}</p>
          <div class="rezeptur-regler-raster">

            <div class="wahl-feld">
              <div class="rezeptur-menge rechner-feld">
                <label for="filter-mehl">{{ 'hub.kaffeemehl' | t }} <span class="wertanzeige" id="filter-mehl-anzeige">12 g</span></label>
                <input type="range" id="filter-mehl" min="12" max="24" step="1" value="12" aria-valuetext="{{ 'hub.gramm' | t: n: 12 }}">
                <div class="mengen-stufen" id="filter-mengen-stufen" aria-hidden="true"><span>12</span><span>15</span><span>18</span><span>21</span><span>24</span></div>
              </div>
            </div>

            <div class="wahl-feld">
              <span class="rolle" id="filter-roestung-titel">{{ 'hub.roestung_frage' | t }}</span>
              <div class="roestgrad-schalter" id="filter-roestung" role="group" aria-labelledby="filter-roestung-titel">
                <span class="schalter-fuellung" id="filter-fuellung" aria-hidden="true"></span>
                <button type="button" class="ist-aktiv" data-roestung="hell" aria-pressed="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <g transform="translate(12 12) rotate(25)"><ellipse rx="6" ry="8.5"/><path d="M0-8.5c-3 4 3 13 0 17"/></g>
                  </svg>
                  <span>{{ 'hub.eher_hell' | t }}</span>
                </button>
                <button type="button" data-roestung="dunkel" aria-pressed="false">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <mask id="filter-kerbe" maskUnits="userSpaceOnUse" x="-10" y="-10" width="20" height="20">
                      <rect x="-10" y="-10" width="20" height="20" fill="#fff"/>
                      <path d="M0-8.5c-3 4 3 13 0 17" fill="none" stroke="#000" stroke-width="1.6"/>
                    </mask>
                    <g transform="translate(12 12) rotate(25)"><ellipse rx="6" ry="8.5" fill="currentColor" stroke="none" mask="url(#filter-kerbe)"/></g>
                  </svg>
                  <span>{{ 'hub.eher_dunkel' | t }}</span>
                </button>
              </div>
              <p class="schritt-hinweis">{{ 'hub_filter.temperatur_vor' | t }} <strong id="filter-hinweis-temperatur">{{ 'hub_filter.hinweis_hell' | t }}</strong>{{ 'hub_filter.temperatur_nach' | t }}</p>
            </div>

          </div>

          <div class="verhaeltnis-zeile">
            <p class="verhaeltnis-charakter" id="filter-verhaeltnis-charakter">{{ start_charakter }}</p>

            <div class="ergebnis-verhaeltnis">
              <span class="rolle">{{ 'hub.verhaeltnis' | t }}</span>
              <div class="verhaeltnis-kopf">
                <span class="verhaeltnis-zahl" id="filter-verhaeltnis-zahl">1 : 16{{ dez }}7</span>
                <span class="verhaeltnis-info" id="filter-verhaeltnis-liter">{{ 'hub_filter.liter' | t: n: '60 g' }}</span>
              </div>
              <div class="verhaeltnis-balken" aria-hidden="true">
                <span class="teil teil--mehl"></span>
                <span class="teil teil--tasse" id="filter-teil-wasser"></span>
              </div>
              <div class="verhaeltnis-skala"><span>{{ 'hub.kaffeemehl' | t }}</span><span>{{ 'hub_filter.wasser' | t }}</span></div>
            </div>

            <div class="verhaeltnis-wahl rechner-feld">
              <label class="rolle" for="filter-verhaeltnis">{{ 'hub_filter.staerke_frage' | t }}</label>
              <div class="mengen-stufen" id="filter-verhaeltnis-stufen" aria-hidden="true">
                {%- for s in stufen -%}
                  {%- assign k = 'hub_filter.charakter_' | append: forloop.index -%}
                <span data-charakter="{{ k | t }}">{{ s | replace: '.', dez }}</span>
                {%- endfor -%}
              </div>
              <input type="range" id="filter-verhaeltnis" min="0" max="6" step="1" value="3" aria-valuetext="1{{ zu }}16{{ dez }}7, {{ erster }}{{ rest }}">
              <div class="verhaeltnis-skala" aria-hidden="true"><span>{{ 'hub_filter.kraeftiger' | t }}</span><span>{{ 'hub_filter.leichter' | t }}</span></div>
            </div>
          </div>
        </div>

        <p class="rezeptur-satz" id="filter-rezeptur-satz"></p>
      </div>

      <div class="raster-kopf">
        <div>
          <h3 class="raster-titel">{{ 'hub_filter.routine_titel' | t }}</h3>
          <p class="raster-lead">{% if hat_guides %}{{ 'hub_filter.routine_lead_guides' | t }}{% else %}{{ 'hub_filter.routine_lead' | t }}{% endif %}</p>
        </div>
        <div class="reihe-knoepfe reihe-knoepfe--hell" id="routine-pfeile" hidden>
          <button class="reihe-knopf" type="button" data-richtung="-1" aria-label="{{ 'hub.zurueck' | t }}" aria-controls="routine-raster" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></button>
          <button class="reihe-knopf" type="button" data-richtung="1" aria-label="{{ 'hub.weiter' | t }}" aria-controls="routine-raster"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
        </div>
      </div>

      <div class="schritte-raster schritte-raster--routine" id="routine-raster"
           tabindex="0" role="region" aria-label="{{ 'hub_filter.routine_aria' | t }}">
        {%- for i in (1..5) -%}
          {%- liquid
            assign k = 'hub_filter.schritt_' | append: i
            assign k_titel = k | append: '_titel'
            assign k_text = k | append: '_text'
            assign k_alt = k | append: '_alt'
            assign bild_id = 'routine_bild_' | append: i
            assign bild = section.settings[bild_id]
            assign alt = k_alt | t
            capture tiefer
              if i == 1
                if seite_wasser != blank
                  echo '<li><a href="' | append: seite_wasser.url | append: '">'
                  echo 'hub_filter.tiefer_wasser' | t
                  echo '</a></li>'
                endif
              elsif i == 4
                if hat_guides
                  echo '<li><a href="#brewguides">'
                  echo 'hub_filter.tiefer_guides' | t
                  echo '</a></li>'
                endif
                if finder != blank
                  echo '<li><a href="' | append: finder.url | append: '">'
                  echo 'hub_filter.station_methoden_titel' | t
                  echo '</a></li>'
                endif
              elsif i == 5
                if seite_koffein != blank
                  echo '<li><a href="' | append: seite_koffein.url | append: '">'
                  echo 'hub_filter.tiefer_koffein' | t
                  echo '</a></li>'
                endif
                if artikel_koffein != blank
                  echo '<li><a href="' | append: artikel_koffein.url | append: '">'
                  echo 'hub.koffein_artikel' | t
                  echo '</a></li>'
                endif
              endif
            endcapture
          -%}
        <article class="schritt-karte">
          <div class="schritt-karte-bild"><span class="nummer">0{{ i }}</span>
            {%- if bild != blank %}
            {{ bild | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 600, 900', sizes: '(min-width: 860px) 30vw, 100vw', alt: alt }}
            {%- endif %}
          </div>
          <div class="schritt-karte-koerper">
            <h4>{{ k_titel | t }}</h4>
            <p>
              {%- if i == 3 -%}
              <strong id="filter-bloom-satz">{{ 'hub_filter.bloom' | t: n: 40 }}</strong>
              {% elsif i == 4 -%}
              <strong id="filter-guss-satz">{{ 'hub_filter.guss' | t: n: 200 }}</strong>
              {% endif -%}
              {{ k_text | t }}</p>
            {%- if tiefer != blank %}
            <ul class="schritt-tiefer">{{ tiefer }}</ul>
            {%- endif %}
          </div>
        </article>
        {%- endfor %}
      </div>

      <button class="btn btn--hell mehr-knopf" type="button" id="routine-mehr"
              aria-expanded="false" aria-controls="routine-raster"
              data-text-zu="{{ 'hub.alle_schritte' | t }}" data-text-auf="{{ 'hub.weniger' | t }}" hidden>
        <span class="wort">{{ 'hub.alle_schritte' | t }}</span>
      </button>
    </div>

    <div class="merksatz" data-reveal style="max-width:none">
      {%- if hat_guides %}
      {{ 'hub_filter.merksatz_guides_html' | t }}
      {%- else %}
      {{ 'hub_filter.merksatz_html' | t }}
      {%- endif %}
    </div>
  </div>
</section>

{%- if n_bohnen > 0 %}
<section class="sektion" id="bohnen">
  <div class="wrap">
    <div class="sektion-kopf">
      <div class="text">
        <span class="eyebrow">{% if nr_bohnen < 10 %}0{% endif %}{{ nr_bohnen }} · {{ 'hub_filter.bohnen_eyebrow' | t }}</span>
        <h2 class="titel-breit" data-split="zeilen">{{ 'hub_filter.bohnen_titel_html' | t }}</h2>
        <p>{{ 'hub_filter.bohnen_text' | t: anzahl: anzahl_wort }}</p>
      </div>
      <a class="btn btn--linie" href="{{ kollektion.url }}" data-pfeil>{{ 'hub.alle_anzeigen' | t }}</a>
    </div>

    <div class="produkt-raster" data-batch>
      {%- for p in kollektion.products -%}
      {%- render 'bw-produkt-karte', p: p -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif %}

{%- if n_rezepte > 0 %}
<section class="sektion" id="rezepte" style="padding-top:clamp(40px,5vw,70px)">
  <div class="wrap">
    <div class="sektion-kopf">
      <div class="text">
        <span class="eyebrow">{% if nr_rezepte < 10 %}0{% endif %}{{ nr_rezepte }} · {{ 'hub_filter.rezepte_eyebrow' | t }}</span>
        <h2 data-split="zeilen">{{ 'hub_filter.rezepte_titel_html' | t }}</h2>
        <p>{{ 'hub_filter.rezepte_text' | t }}</p>
      </div>
      <a class="btn btn--linie" href="{{ blogs['kaffeerezepte'].url }}" data-pfeil>{{ 'hub.alle_rezepte' | t }}</a>
    </div>

    <div class="rezepte-raster rezepte-raster--vier" data-batch>
      {{- rezepte -}}
    </div>
  </div>
</section>
{%- endif %}

{%- if hat_methoden %}
<section class="sektion" id="brewguides" style="padding-top:clamp(40px,5vw,70px)">
  <div class="wrap">
    <div class="sektion-kopf">
      <div class="text">
        <span class="eyebrow">{% if nr_methoden < 10 %}0{% endif %}{{ nr_methoden }} · {% if hat_guides %}{{ 'hub_filter.methoden_eyebrow_guides' | t }}{% else %}{{ 'hub_filter.methoden_eyebrow' | t }}{% endif %}</span>
        <h2 data-split="zeilen">{{ 'hub_filter.methoden_titel_html' | t }}</h2>
        <p>{{ 'hub_filter.methoden_text' | t }}{% if hat_guides %} {{ 'hub_filter.methoden_text_guides' | t }}{% endif %}</p>
      </div>
    </div>

    <div class="brewguides brewguides--vier" id="guide-raster" data-batch>
      {%- if finder != blank %}
      <div class="seitenbox">
        <img class="signet" src="{{ 'logo-hellorange-signet.svg' | asset_url }}" alt="" aria-hidden="true" width="764" height="923">
        <span class="eyebrow">{{ 'hub.finder' | t }}</span>
        <h4>{{ 'hub_filter.finder_titel' | t }}</h4>
        <p>{% if hat_guides %}{{ 'hub_filter.finder_text_guides' | t }}{% else %}{{ 'hub_filter.finder_text' | t }}{% endif %}</p>
        <a class="btn btn--hell" href="{{ finder.url }}" data-pfeil>{{ 'hub_filter.finder_knopf' | t }}</a>
      </div>
      {%- endif %}
    </div>

    <button class="btn btn--linie mehr-knopf" type="button" id="guide-mehr"
            aria-expanded="false" aria-controls="guide-raster"
            data-text-zu="{{ 'hub_filter.alle_methoden' | t }}" data-text-auf="{{ 'hub.weniger' | t }}" hidden>
      <span class="wort">{{ 'hub_filter.alle_methoden' | t }}</span>
    </button>
  </div>
</section>
{%- endif %}

{%- if wissen != blank %}
<section class="sektion wissen" id="filter-wissen">
  <div class="wrap">
    <div class="sektion-kopf">
      <div class="text">
        <span class="eyebrow">{% if nr_wissen < 10 %}0{% endif %}{{ nr_wissen }} · {{ 'hub_filter.wissen_eyebrow' | t }}</span>
        <h2 data-split="zeilen">{{ 'hub.tiefer_titel' | t }}</h2>
        <p>{{ 'hub.wissen_text' | t }}</p>
      </div>
      {%- if blogs['kaffeewissen'] != blank %}
      <a class="btn btn--linie" href="{{ blogs['kaffeewissen'].url }}" data-pfeil>{{ 'hub.alle_beitraege' | t }}</a>
      {%- endif %}
    </div>

    <div class="beitraege" data-batch>
      {{ wissen }}
    </div>
  </div>
</section>
{%- endif %}

{% render 'bw-hub-fragen' %}

{%- assign andere = pages['espresso'] -%}
{%- if andere != blank %}
<section class="sektion" style="padding-top:0">
  <div class="wrap">
    <div class="hub-band" data-reveal>
      <img class="signet" src="{{ 'logo-hellorange-signet.svg' | asset_url }}" alt="" aria-hidden="true" width="764" height="923">
      <div>
        <span class="eyebrow" style="opacity:.85">{{ 'hub.band_eyebrow' | t }}</span>
        <h2 style="margin-top:14px">{{ 'hub_filter.band_titel_html' | t }}</h2>
        <p>{{ 'hub_filter.band_text' | t }}</p>
      </div>
      <a class="btn btn--hell" href="{{ andere.url }}" data-pfeil>{{ 'shop.espresso_knopf' | t }}</a>
    </div>
  </div>
</section>
{%- endif %}

{% render 'bw-hub-schema' %}

<script src="{{ 'hubs.js' | asset_url }}" defer></script>
<script src="{{ 'atmosphaere.js' | asset_url }}" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (!window.BWHub) return;
    BWHub.filter();
    BWHub.klappRaster('#routine-raster', '#routine-mehr', { hart: true });
    BWHub.schritteBand('#routine-raster', '#routine-pfeile');
    // Aufklappen erst ab drei Guide-Karten, wie im Prototyp.
    BWHub.klappRaster('#guide-raster', '#guide-mehr', {
      gilt: function () { return document.querySelectorAll('#guide-raster > .brewguide').length > 2; }
    });
  });
</script>

{% schema %}
{
  "name": "Filterkaffee-Hub",
  "settings": [
    { "type": "header", "content": "Fotos der Filterkaffee-Routine" },
    { "type": "paragraph", "content": "Platzhalter aus den Cold-Brew-Rezepten, bis es eigene Aufnahmen vom Handaufguss gibt. Den Ausschnitt setzt der Fokuspunkt des Bildes." },
    { "type": "image_picker", "id": "routine_bild_1", "label": "Schritt 1: Wasser erhitzen, Filter spülen" },
    { "type": "image_picker", "id": "routine_bild_2", "label": "Schritt 2: Mahlen und wiegen" },
    { "type": "image_picker", "id": "routine_bild_3", "label": "Schritt 3: Blooming" },
    { "type": "image_picker", "id": "routine_bild_4", "label": "Schritt 4: Aufgiessen" },
    { "type": "image_picker", "id": "routine_bild_5", "label": "Schritt 5: Probieren und anpassen" },
    { "type": "header", "content": "Tiefer rein" },
    { "type": "article_list", "id": "artikel", "label": "Artikel", "limit": 3, "info": "Leer: die neusten Wissensartikel zum Thema Filter. Ohne solche Artikel fällt der Abschnitt weg." }
  ]
}
{% endschema %}
