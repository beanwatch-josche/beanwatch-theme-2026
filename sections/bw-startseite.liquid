{%- comment -%}
  Die Startseite (seit 0.10.0), übertragen aus index.html der Werkstatt:
  Markup, Klassen und IDs wie dort, denn faehren.js, animationen.js,
  kaffees.js, prozess.js und besser.js hängen an ihnen. Feste Texte aus den
  Sprachdateien (start), Abschnitte wie im Prototyp (Entscheid Joscha
  07.10.2026).

  Woher die Inhalte kommen:
    Kopf, Laufband, Prozessweg, Über uns, Newsletter   Sprachdateien; das
                  Foto bei «Willkommen» ist eine Einstellung der Sektion.
                  Die Röstereifähre fährt die Haufen aus beutel.js (seit
                  0.13.0, vorher still sechs Beutel in einer Reihe)
    Unsere Kaffees  Kollektionen espresso und filterkaffee ohne Decaf, dann
                  decaf-coffee, je in Shop-Reihenfolge, wie auf der
                  Shop-Seite; data-art für den Filter von kaffees.js
    Kaffeefinder  erst, wenn es die Seite welcher-kaffee gibt (Entscheid
                  Joscha). Klassisch und fruchtig führen zu den Kollektionen
                  klassische-espressos und fruchtige-espressos, solange es
                  sie nicht gibt zum Ergebnis im Finder; Filterkaffee zum
                  Abschnitt auf der Shop-Seite.
    Kaffee besser machen  je Blog der neueste Beitrag (kaffeerezepte,
                  kaffeewissen, brew-guides, barista-guides) und die Seiten
                  koffeinrechner und wasserhaerte, in der Reihenfolge des
                  Prototyps (Rezept, Artikel, Brew Guide, Tool, Barista
                  Guide, Tool). Was es nicht gibt, fällt weg; die
                  Rasterplatzierung schliesst die Lücken.
    Newsletter    Kundenformular von Shopify mit dem Tag newsletter, wie
                  im Fuss des bisherigen Shops
  Seitentitel und Meta-Beschreibung kommen aus den Shop-Einstellungen
  (bw-kopfdaten).
{%- endcomment -%}
{%- liquid
  assign pfeil = '<svg class="pfeil" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>'
  assign pfeil_box = pfeil | replace: ' width="17" height="17"', ''
  assign pfeil_klein = pfeil | replace: '"17"', '"15"'

  # Guides: Ein Blog zählt erst mit einem veröffentlichten Artikel.
  assign hat_brew = false
  if blogs['brew-guides'] != blank
    assign n = blogs['brew-guides'].articles_count | plus: 0
    if n > 0
      assign hat_brew = true
    endif
  endif
  assign hat_barista = false
  if blogs['barista-guides'] != blank
    assign n = blogs['barista-guides'].articles_count | plus: 0
    if n > 0
      assign hat_barista = true
    endif
  endif

  # Unsere Kaffees, gruppiert wie auf der Shop-Seite
  assign k_decaf = collections['decaf-coffee']
  assign decaf_ids = ''
  if k_decaf != blank
    assign decaf_ids = k_decaf.products | map: 'id'
  endif
  assign n_kaffees = 0
  capture kaffees
    for p in collections['espresso'].products
      unless decaf_ids contains p.id
        render 'bw-produkt-karte', p: p, art: 'espresso'
        assign n_kaffees = n_kaffees | plus: 1
      endunless
    endfor
    for p in collections['filterkaffee'].products
      unless decaf_ids contains p.id
        render 'bw-produkt-karte', p: p, art: 'filter'
        assign n_kaffees = n_kaffees | plus: 1
      endunless
    endfor
    for p in k_decaf.products
      render 'bw-produkt-karte', p: p, art: 'decaf'
      assign n_kaffees = n_kaffees | plus: 1
    endfor
  endcapture
  assign ziel_kaufen = '#kaffees'
  if n_kaffees == 0
    assign ziel_kaufen = routes.collections_url
  endif

  # Kaffeefinder
  assign finder = pages['welcher-kaffee']
  assign ziel_klassisch = ''
  assign ziel_fruchtig = ''
  if finder != blank
    assign ziel_klassisch = finder.url | append: '#klassisch'
    assign ziel_fruchtig = finder.url | append: '#fruchtig'
  endif
  if collections['klassische-espressos'] != blank
    assign ziel_klassisch = collections['klassische-espressos'].url
  endif
  if collections['fruchtige-espressos'] != blank
    assign ziel_fruchtig = collections['fruchtige-espressos'].url
  endif

  # Prozessweg, Station 5: «, Guides» erst mit Brew Guides, der Rechner
  # als Link erst, wenn es seine Seite gibt
  assign guides_satz = ''
  if hat_brew
    assign guides_satz = 'start.guides' | t
  endif
  assign werkzeug = 'start.phase_5_werkzeug' | t
  if pages['wasserhaerte'] != blank
    assign werkzeug = '<a href="' | append: pages['wasserhaerte'].url | append: '">' | append: werkzeug | append: '</a>'
  endif

  assign wissen_seite = blogs['kaffeewissen'].url | default: routes.root_url
-%}

