{%- comment -%}
  Kopfleiste, übertragen aus assets/js/shell.js der Werkstatt. Klassen und
  IDs sind dieselben, damit basis.js (Ankleben, Fortschrittsbalken) und das
  CSS unverändert greifen. Die Navigation steht fest im Code (Entscheid vom
  05.10.2026), die Wörter kommen aus den Sprachdateien. Ein Punkt erscheint
  nur, wenn sein Ziel in Shopify existiert.
  Das Menü auf dem Handy öffnet bw-theme.js.
  «Konto» (seit 0.18.0) führt zum Kundenkonto von Shopify, mit Bestellungen
  und Abo, und erscheint nur, wenn der Shop Kundenkonten anbietet.
{%- endcomment -%}
{%- capture aktiv -%}{%- render 'bw-navschluessel' -%}{%- endcapture -%}
{%- capture punkte -%}
  {%- if pages['espresso'] != blank -%}
    <a href="{{ pages['espresso'].url }}"{% if aktiv == 'espresso' %} class="ist-aktiv" aria-current="page"{% endif %}>{{ 'kopf.espresso' | t }}</a>
  {%- endif -%}
  {%- if pages['filterkaffee'] != blank -%}
    <a href="{{ pages['filterkaffee'].url }}"{% if aktiv == 'filterkaffee' %} class="ist-aktiv" aria-current="page"{% endif %}>{{ 'kopf.filterkaffee' | t }}</a>
  {%- endif -%}
  {%- if collections['decaf-coffee'] != blank -%}
    <a href="{{ collections['decaf-coffee'].url }}"{% if aktiv == 'decaf' %} class="ist-aktiv" aria-current="page"{% endif %}>{{ 'kopf.decaf' | t }}</a>
  {%- endif -%}
  {%- if blogs['kaffeewissen'] != blank -%}
    <a href="{{ blogs['kaffeewissen'].url }}"{% if aktiv == 'wissen' %} class="ist-aktiv" aria-current="page"{% endif %}>{{ 'kopf.wissen' | t }}</a>
  {%- endif -%}
  <a href="{{ routes.collections_url }}"{% if aktiv == 'shop' %} class="ist-aktiv" aria-current="page"{% endif %}>{{ 'kopf.shop' | t }}</a>
{%- endcapture -%}

<div class="fortschritt" id="fortschritt"></div>
<header class="kopf" id="kopf">
  <div class="inner">
    <a class="kopf-logo" href="{{ routes.root_url }}" aria-label="{{ 'kopf.startseite' | t }}">
      <img src="{{ 'logo-redorange-quer-einzeilig.svg' | asset_url }}" alt="Beanwatch" width="210" height="44">
    </a>

    <nav class="nav" aria-label="{{ 'kopf.hauptnavigation' | t }}">
      {{ punkte }}
    </nav>

    <div class="kopf-aktionen">
      {%- if shop.customer_accounts_enabled %}
      <a class="konto" href="{{ routes.account_url }}" aria-label="{{ 'kopf.konto' | t }}">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
        </svg>
        <span class="wort">{{ 'kopf.konto' | t }}</span>
      </a>
      {%- endif %}
      <a class="warenkorb" href="{{ routes.cart_url }}" data-bw-warenkorb-oeffnen>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <span class="wort">{{ 'kopf.warenkorb' | t }}</span>
        <span class="zahl" data-bw-warenkorb-zahl{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
      <button class="menue-knopf" id="menue-knopf" aria-label="{{ 'kopf.menue_oeffnen' | t }}" aria-expanded="false" aria-controls="mobilmenue">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.8" stroke-linecap="round"><path d="M3 7h18M3 12h18M3 17h18"/></svg>
      </button>
    </div>
  </div>
</header>

<div class="mobilmenue" id="mobilmenue" hidden>
  <nav aria-label="{{ 'kopf.mobile_navigation' | t }}">
    {{ punkte }}
    {%- if blogs['kaffeerezepte'] != blank %}
    <a href="{{ blogs['kaffeerezepte'].url }}">{{ 'kopf.rezepte' | t }}</a>
    {%- endif %}
    {%- if pages['werkzeuge'] != blank %}
    <a href="{{ pages['werkzeuge'].url }}">{{ 'kopf.tools' | t }}</a>
    {%- endif %}
  </nav>
  {%- render 'bw-sprachwahl', ort: 'menue', zusatz: ' sprachwahl--menue' %}
</div>

{% schema %}
{
  "name": "Kopfleiste",
  "class": "bw-kopf-sektion",
  "settings": [
    {
      "type": "paragraph",
      "content": "Die Navigation steht fest im Code. Ein Punkt erscheint, sobald die zugehörige Seite, Kollektion oder der Blog in Shopify existiert."
    }
  ]
}
{% endschema %}
