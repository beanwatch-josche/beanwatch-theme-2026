{%- comment -%}
  Strukturierte Daten der Wissensartikel (seit 0.8.0): Article und
  BreadcrumbList, wie im Prototyp (werkzeug/artikel-bauen.rb). WebSite und
  Organization stehen auf jeder Seite (bw-kopfdaten).

  Gegenüber dem bisherigen Shop ({{ article | structured_data }}): Autor mit
  Profilseite aus custom.autoren_url, Sprache, dateModified aus
  custom.content_updated_at (sonst das Veröffentlichungsdatum, wie bei den
  Rezepten), die Brotkrumen mit Hub und Kurzname wie auf der Seite.

  kurzname  Kurzname für die letzte Brotkrume
  hub_url   Espresso- oder Filter-Hub, sonst leer
  hub_name  sein Name
{%- endcomment -%}
{%- liquid
  assign mf = article.metafields.custom
  assign seite = request.origin | append: article.url
  assign geaendert = mf.content_updated_at.value | default: article.published_at
  assign beschreibung = page_description | default: article.excerpt | strip_html | strip_newlines | strip
  assign bild = ''
  if article.image
    assign bild = article.image | image_url: width: 1200
    unless bild contains 'http'
      assign bild = bild | prepend: 'https:'
    endunless
  endif
  assign position = 3
  if hub_url != blank
    assign position = 4
  endif
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ article.title | json }},
  {%- if beschreibung != blank %}
  "description": {{ beschreibung | truncate: 300 | json }},
  {%- endif %}
  {%- if bild != blank %}
  "image": [{{ bild | json }}],
  {%- endif %}
  "author": { "@type": "Person", "name": {{ article.author | json }}{% if mf.autoren_url.value != blank %}, "url": {{ mf.autoren_url.value | json }}{% endif %} },
  "publisher": { "@type": "Organization", "name": {{ shop.name | json }}, "url": {{ request.origin | append: routes.root_url | json }} },
  "mainEntityOfPage": { "@type": "WebPage", "@id": {{ seite | json }} },
  "inLanguage": {{ request.locale.iso_code | append: '-CH' | json }},
  "datePublished": {{ article.published_at | date: '%Y-%m-%d' | json }},
  "dateModified": {{ geaendert | date: '%Y-%m-%d' | json }}
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": {{ 'rezept.schema_start' | t | json }}, "item": {{ request.origin | append: routes.root_url | json }} },
    { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ request.origin | append: blog.url | json }} },
    {%- if hub_url != blank %}
    { "@type": "ListItem", "position": 3, "name": {{ hub_name | json }}, "item": {{ request.origin | append: hub_url | json }} },
    {%- endif %}
    { "@type": "ListItem", "position": {{ position }}, "name": {{ kurzname | json }}, "item": {{ seite | json }} }
  ]
}
</script>
