{%- comment -%}
  Datenblock #bw-finder-texte (seit 0.11.0) für die Finder aus der Werkstatt:
  übersetzte Fragen, Antworten und Labels, dazu Ziele, die es im Shop gibt.
  Ohne diesen Block zeigen kaffeefinder.js und hubs.js den deutschen
  Wortlaut und die Pfade des Prototyps. Texte in locales/ unter finder.*.

  art   'kaffee'     Kaffeefinder (kaffeefinder.js): Fragen und Anleitungen.
                     Eine Anleitung erscheint nur, wenn ihr Ziel
                     veröffentlicht ist; beim V60 sonst das Grundrezept
                     Filterkaffee, wie im Start-Modus des Prototyps.
        'maschinen'  Maschinen- und Methodenfinder (hubs.js, finderTexte()):
        'methoden'   Fragen, Begründungen, Guide-Karten und Ersatzziele.
                     Ein Guide bekommt seine Adresse nur, wenn der Artikel
                     im Shop veröffentlicht ist; sonst führt die Karte zum
                     Ersatz (hubs.js weg()).

  Die Handles der Guides sind die des Prototyps (start.js, Dateinamen).
  Für Chemex, French Press, AeroPress und Cold Brew gibt es noch keine
  Artikel; die Handles hier sind eine Annahme, bis sie geschrieben sind.

  Aufruf: {%- render 'bw-finder-texte', art: 'kaffee' -%}
{%- endcomment -%}
{%- liquid
  assign zum_grundrezept = 'hub.zum_grundrezept' | t
  assign url_filter = routes.root_url
  if pages['filterkaffee'] != blank
    assign url_filter = pages['filterkaffee'].url | append: '#rezeptur'
  endif
-%}
{%- if art == 'kaffee' -%}
{%- liquid
  assign a_vollautomat = articles['barista-guides/kaffeevollautomat']
  assign a_bialetti = articles['barista-guides/bialetti']
  assign a_v60 = articles['brew-guides/hario-v60']
  assign a_coldbrew = articles['kaffeerezepte/cold-brew']
  assign a_creme = articles['kaffeerezepte/cafe-creme-rezept']
  assign a_cappuccino = articles['kaffeerezepte/cappuccino-rezept']
-%}
<script type="application/json" id="bw-finder-texte">
{
  "frage": {{ 'finder.frage' | t | json }},
  "fragen": {
    "setup": { "titel": {{ 'finder.f_setup_titel' | t | json }}, "antworten": [
      { "text": {{ 'finder.f_setup_1' | t | json }} },
      { "text": {{ 'finder.f_setup_2' | t | json }} },
      { "text": {{ 'finder.f_setup_3' | t | json }} },
      { "text": {{ 'finder.f_setup_4' | t | json }} },
      { "text": {{ 'finder.f_setup_5' | t | json }} }
    ] },
    "getraenk": { "titel": {{ 'finder.f_getraenk_titel' | t | json }}, "antworten": [
      { "text": {{ 'finder.f_getraenk_1' | t | json }} },
      { "text": {{ 'finder.f_getraenk_2' | t | json }}, "zusatz": {{ 'finder.f_getraenk_2_zusatz' | t | json }} },
      { "text": {{ 'finder.f_getraenk_3' | t | json }} }
    ] },
    "stil": { "titel": {{ 'finder.f_stil_titel' | t | json }}, "antworten": [
      { "text": {{ 'finder.f_stil_1' | t | json }}, "zusatz": {{ 'finder.f_stil_1_zusatz' | t | json }} },
      { "text": {{ 'finder.f_stil_2' | t | json }}, "zusatz": {{ 'finder.f_stil_2_zusatz' | t | json }} }
    ] }
  },
  "anleitungen": {
    "vollautomat": {% if a_vollautomat != blank %}{ "text": {{ 'finder.a_vollautomat' | t | json }}, "href": {{ a_vollautomat.url | json }} }{% else %}null{% endif %},
    "bialetti": {% if a_bialetti != blank %}{ "text": {{ 'finder.a_bialetti' | t | json }}, "href": {{ a_bialetti.url | json }} }{% else %}null{% endif %},
    "v60": {% if a_v60 != blank %}{ "text": {{ 'finder.a_v60' | t | json }}, "href": {{ a_v60.url | json }} }{% elsif pages['filterkaffee'] != blank %}{ "text": {{ 'finder.a_filter_grundrezept' | t | json }}, "href": {{ url_filter | json }} }{% else %}null{% endif %},
    "coldbrew": {% if a_coldbrew != blank %}{ "text": {{ 'finder.a_coldbrew' | t | json }}, "href": {{ a_coldbrew.url | json }} }{% else %}null{% endif %},
    "creme": {% if a_creme != blank %}{ "text": {{ 'finder.a_creme' | t | json }}, "href": {{ a_creme.url | json }} }{% else %}null{% endif %},
    "cappuccino": {% if a_cappuccino != blank %}{ "text": {{ 'finder.a_cappuccino' | t | json }}, "href": {{ a_cappuccino.url | json }} }{% else %}null{% endif %}
  }
}
</script>
{%- else -%}
{%- liquid
  assign url_espresso = routes.root_url
  assign url_rezepte = routes.root_url
  if pages['espresso'] != blank
    assign url_espresso = pages['espresso'].url | append: '#rezeptur'
    assign url_rezepte = pages['espresso'].url | append: '#getraenke'
  endif
  assign url_bohnen = routes.collections_url
  if pages['welcher-kaffee'] != blank
    assign url_bohnen = pages['welcher-kaffee'].url | append: '#klassisch'
  elsif collections['espresso'] != blank
    assign url_bohnen = collections['espresso'].url
  endif
  assign a_v60 = articles['brew-guides/hario-v60']
  assign a_coldbrew = articles['kaffeerezepte/cold-brew']
  assign g_einkreiser = articles['barista-guides/einkreiser']
  assign g_zweikreiser = articles['barista-guides/zweikreiser']
  assign g_thermoblock = articles['barista-guides/thermoblock']
  assign g_vollautomat = articles['barista-guides/kaffeevollautomat']
  assign g_kapsel = articles['barista-guides/kapselmaschine']
  assign g_bialetti = articles['barista-guides/bialetti']
  assign g_v60 = articles['brew-guides/hario-v60']
  assign g_chemex = articles['brew-guides/chemex']
  assign g_frenchpress = articles['brew-guides/french-press']
  assign g_aeropress = articles['brew-guides/aeropress']
  assign g_coldbrew = articles['brew-guides/cold-brew']
-%}
