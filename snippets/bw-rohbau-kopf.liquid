{%- comment -%}
  Seitenkopf für die Rohbau-Vorlagen, mit den Klassen des Prototyps und der
  Entwurfsmarke (Element 30 im CI-Guide). Verschwindet Vorlage für Vorlage,
  sobald ihr Design aus der Werkstatt übertragen ist.
  Parameter: eyebrow, titel, lead (alle optional ausser titel)
{%- endcomment -%}
<section class="seitenkopf seitenkopf--hell">
  <div class="wrap">
    {%- if eyebrow != blank %}
    <span class="eyebrow" style="color:var(--redorange);display:block">{{ eyebrow }}</span>
    {%- endif %}
    <h1>{{ titel }}</h1>
    {%- if lead != blank %}
    <p class="lead">{{ lead }}</p>
    {%- endif %}
    <p class="entwurfsmarke">{{ 'rohbau.hinweis' | t }}</p>
  </div>
</section>
