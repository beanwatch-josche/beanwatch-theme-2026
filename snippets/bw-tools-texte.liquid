{%- comment -%}
  Datenblock #bw-tools-texte (seit 0.11.0) für tools.js aus der Werkstatt:
  die Texte, die der Koffeinrechner, das Teilen-Fenster, der Wasserrechner
  und der Brüh-Timer zur Laufzeit schreiben, die zwölf Getränke, das
  Dezimalzeichen der Sprache und die Adresse der Rechnerseite (für das
  geteilte Bild und den Teiltext). Ohne den Block schreibt tools.js den
  deutschen Wortlaut des Prototyps. Texte in locales/ unter tools.*.
  Gehört auf jede Seite, die tools.js lädt.
  Aufruf: {%- render 'bw-tools-texte' -%}
{%- endcomment -%}
{%- liquid
  assign seite_koffein = pages['koffeinrechner']
  assign host = request.host | default: shop.domain | remove_first: 'www.'
  assign adresse = host
  assign adresse_url = request.origin | append: routes.root_url
  if seite_koffein != blank
    assign adresse = host | append: seite_koffein.url
    assign adresse_url = request.origin | append: seite_koffein.url
  endif
-%}
<script type="application/json" id="bw-tools-texte">
{
