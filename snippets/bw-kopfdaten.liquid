{%- comment -%}
  Titel, Beschreibung, Canonical und Vorschaukarten für soziale Netzwerke.
  hreflang setzt Shopify selbst für alle veröffentlichten Sprachen.
  Wie im Prototyp: «Titel · Beanwatch». Die Startseite trägt seit 0.10.0
  den Titel aus den Shop-Einstellungen (page_title), wie im alten Theme,
  mit «· Beanwatch», wenn er die Marke nicht schon nennt.
{%- endcomment -%}
{%- liquid
  assign marke = 'Beanwatch'
  assign titel = page_title
  assign beschreibung = page_description
  # Die Shop-Seite (bw-shop) gibt es unter /collections und
  # /collections/all. Wie im bisherigen Shop zeigt das Menü auf
  # /collections; beide tragen den Titel des Prototyps und die
  # Meta-Beschreibung aus dem Shop-Metafeld seo.collections_description.
  assign ist_shop = false
  if request.page_type == 'list-collections'
    assign ist_shop = true
  elsif request.page_type == 'collection' and collection.handle == 'all'
    assign ist_shop = true
  endif
  if ist_shop
    assign titel = 'shop.seitentitel' | t
    assign beschreibung = shop.metafields.seo.collections_description.value
    if beschreibung == blank
      assign beschreibung = 'shop.meta' | t
    endif
  endif
  if current_tags
    assign schlagworte = current_tags | join: ', '
    assign titel = titel | append: ' · ' | append: schlagworte
  endif
  if current_page != 1
    assign seite = 'allgemein.seite' | t: nummer: current_page
    assign titel = titel | append: ' · ' | append: seite
  endif
  # Getaggte Blog- und Kollektionsseiten (/blogs/kaffeerezepte/tagged/…)
  # zeigen auf die Blog- oder Kollektionsseite, wie im bisherigen Shop.
  # Sonst zählt Google jede Tag-Seite als eigene Seite mit fast gleichem
  # Inhalt.
  assign kanonisch = canonical_url
  if request.page_type == 'blog' and current_tags
    assign kanonisch = request.origin | append: blog.url
  elsif request.page_type == 'collection' and current_tags
    assign kanonisch = request.origin | append: collection.url
  endif
  if ist_shop
    assign kanonisch = request.origin | append: routes.collections_url
  endif
  if titel contains marke
    assign voll = titel
  else
    assign voll = titel | append: ' · ' | append: marke
  endif
-%}
<title>{{ voll | escape }}</title>
{%- if beschreibung != blank %}
<meta name="description" content="{{ beschreibung | escape }}">
{%- endif %}
<link rel="canonical" href="{{ kanonisch }}">
{%- if settings.favicon != blank %}
<link rel="icon" href="{{ settings.favicon | image_url: width: 64 }}">
{%- else %}
<link rel="icon" href="{{ 'logo-redorange-signet.svg' | asset_url }}" type="image/svg+xml">
{%- endif %}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ kanonisch }}">
<meta property="og:title" content="{{ voll | escape }}">
<meta property="og:type" content="{% if request.page_type == 'product' %}product{% elsif request.page_type == 'article' %}article{% else %}website{% endif %}">
<meta property="og:description" content="{{ beschreibung | default: shop.description | escape }}">
{%- if page_image %}
<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="{{ 1200 | divided_by: page_image.aspect_ratio | round }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
{%- comment -%} Wie im bisherigen Shop auf jeder Seite: Website und Organisation. {%- endcomment %}
<script type="application/ld+json">
[
  { "@context": "https://schema.org", "@type": "WebSite", "name": {{ shop.name | json }}, "url": {{ shop.url | json }} },
  { "@context": "https://schema.org", "@type": "Organization", "name": {{ shop.name | json }}, "url": {{ shop.url | json }} }
]
</script>
