{%- comment -%}
  Dauer eines Rezepts für Karten, aus der ISO-Zeit (PT1H45M). Regeln wie
  dauer_kurz in werkzeug/teaser-abgleichen.rb der Werkstatt: unter einer
  Stunde in Minuten, ab vier Stunden gerundet in Stunden, dazwischen
  «1 Std. 45 Min.». Ohne Zeit bleibt die Ausgabe leer.
  Aufruf: {%- render 'bw-dauer', iso: basis.iso_total_time.value -%}
{%- endcomment -%}
{%- liquid
  assign rest = iso | default: '' | remove: 'PT'
  assign minuten = 0
  if rest contains 'H'
    assign teile = rest | split: 'H'
    assign minuten = teile[0] | times: 60
    assign rest = teile[1] | default: ''
  endif
  assign rest = rest | split: 'M' | first | default: 0
  assign minuten = minuten | plus: rest
  if minuten <= 0
    echo ''
  elsif minuten < 60
    echo 'allgemein.dauer_minuten' | t: n: minuten
  elsif minuten >= 240
    assign stunden = minuten | divided_by: 60.0 | round
    echo 'allgemein.dauer_stunden' | t: n: stunden
  else
    assign stunden = minuten | divided_by: 60
    assign uebrig = minuten | modulo: 60
    if uebrig == 0
      echo 'allgemein.dauer_std' | t: h: stunden
    else
      echo 'allgemein.dauer_std_min' | t: h: stunden, m: uebrig
    endif
  endif
-%}
