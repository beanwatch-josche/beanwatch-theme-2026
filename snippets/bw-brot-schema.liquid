{%- comment -%}
  Brotkrumen als BreadcrumbList für Seiten mit Zwischenstufen (seit 0.11.0),
  etwa Start › Kaffeewissen › Tools › Koffeinrechner. Die letzte Stufe ist
  die Seite selbst, wie bei bw-hub-schema.
  name_1, url_1   erste Zwischenstufe (optional)
  name_2, url_2   zweite Zwischenstufe (optional)
  name_ende, url_ende   die letzte Stufe, wenn es keine Seite ist (seit
                  0.12.0, etwa der Blog beim Wissen-Hub); sonst page
  Aufruf: {%- render 'bw-brot-schema', name_1: shop_name, url_1: routes.collections_url -%}
{%- endcomment -%}
{%- liquid
  assign pos = 2
  assign ende_name = name_ende | default: page.title
  assign ende_url = url_ende | default: page.url
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": {{ 'rezept.schema_start' | t | json }}, "item": {{ request.origin | append: routes.root_url | json }} },
    {%- if name_1 != blank and url_1 != blank %}
    { "@type": "ListItem", "position": {{ pos }}, "name": {{ name_1 | json }}, "item": {{ request.origin | append: url_1 | json }} },
    {%- assign pos = pos | plus: 1 -%}
    {%- endif %}
    {%- if name_2 != blank and url_2 != blank %}
    { "@type": "ListItem", "position": {{ pos }}, "name": {{ name_2 | json }}, "item": {{ request.origin | append: url_2 | json }} },
    {%- assign pos = pos | plus: 1 -%}
    {%- endif %}
    { "@type": "ListItem", "position": {{ pos }}, "name": {{ ende_name | json }}, "item": {{ request.origin | append: ende_url | json }} }
  ]
}
</script>
