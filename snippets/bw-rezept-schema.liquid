{%- comment -%}
  Strukturierte Daten der Rezeptseite: BreadcrumbList, Recipe, FAQPage.
  WebSite und Organization stehen auf jeder Seite (bw-kopfdaten).

  Feld für Feld wie im bisherigen Shop (beanwatch-theme, snippets/
  recipe-schema.liquid und sections/faq-accordion.liquid), damit Google
  beim Umzug nichts verliert. Abweichungen, bewusst:
    HowToStep.url   #schritt-N wie im Prototyp; #step-N springt weiter,
                    weil jede Schrittkarte beide Anker trägt.
    HowToStep.name  Titel des Schritts (Feld title an recipe_step, seit
                    06.10.2026), sonst «Schritt N» wie bisher.
    HowToStep.text  Absätze mit Leerzeichen getrennt; bisher klebten Text
                    und «Tipp:» aneinander.
  bewertung.js führt aggregateRating nach dem Laden aus Supabase nach.
{%- endcomment -%}
{%- liquid
  assign mf = article.metafields.custom
  assign basis = mf.recipe_base.value
  assign naehrwerte = mf.recipe_nutrition.value
  assign equipment = mf.recipe_equipment.value
  assign schritte = mf.recipe_steps.value
  assign fragen = mf.recipe_faqs_list.value
  assign anzahl = mf.rating_count.value | default: 0 | plus: 0
  assign geaendert = mf.content_updated_at.value | default: article.published_at
  assign seite = request.origin | append: article.url

  assign prep = basis.prep_time_iso.value
  assign total = basis.iso_total_time.value | default: prep

  assign beschreibung = article.content | replace: '</p>', '</p> ' | strip_html | strip_newlines | replace: '  ', ' ' | strip

  comment
    Bilder für Google in 1:1, 4:3 und 16:9. Zuerst die von Hand
    zugeschnittenen Metafelder schema_image_*, sonst ein Zuschnitt aus dem
    Artikelbild um den Fokuspunkt. Übernommen aus dem bisherigen Shop.
  endcomment
  assign bilder = ''
  assign held = article.image
  if held != blank
    assign held_b = held.width | times: 1.0
    assign held_h = held.height | times: 1.0
    assign held_verh = held_b | divided_by: held_h
    assign fokus_x = held.presentation.focal_point.x | default: 50 | times: 1.0
    assign fokus_y = held.presentation.focal_point.y | default: 50 | times: 1.0
  endif
  assign formate = '1200x1200|1200x900|1600x900' | split: '|'
  for format in formate
    assign masse = format | split: 'x'
    assign aus_b = masse[0] | plus: 0
    assign aus_h = masse[1] | plus: 0
    assign url = blank
    case forloop.index
      when 1
        assign eigenes = mf.schema_image_1x1.value
      when 2
        assign eigenes = mf.schema_image_4x3.value
      else
        assign eigenes = mf.schema_image_16x9.value
    endcase
    if eigenes != blank
      assign url = eigenes | image_url: width: aus_b, height: aus_h, crop: 'center'
    elsif held != blank
      assign ziel_verh = aus_b | times: 1.0 | divided_by: aus_h
      if held_verh >= ziel_verh
        assign schnitt_h = held_h
        assign schnitt_b = held_h | times: ziel_verh | at_most: held_b
        assign halb = schnitt_b | divided_by: 2.0
        assign max_links = held_b | minus: schnitt_b | at_least: 0
        assign links = fokus_x | times: held_b | divided_by: 100.0 | minus: halb | at_least: 0 | at_most: max_links | round
        assign oben = 0
      else
        assign schnitt_b = held_b
        assign schnitt_h = held_b | divided_by: ziel_verh | at_most: held_h
        assign halb = schnitt_h | divided_by: 2.0
        assign max_oben = held_h | minus: schnitt_h | at_least: 0
        assign oben = fokus_y | times: held_h | divided_by: 100.0 | minus: halb | at_least: 0 | at_most: max_oben | round
        assign links = 0
      endif
      assign schnitt_b = schnitt_b | round
      assign schnitt_h = schnitt_h | round
      assign url = held | image_url: crop: 'region', crop_left: links, crop_top: oben, crop_width: schnitt_b, crop_height: schnitt_h, width: aus_b, height: aus_h
    endif
    if url != blank
      unless url contains 'http'
        assign url = url | prepend: 'https:'
      endunless
      assign bilder = bilder | append: url | append: '|'
    endif
  endfor
  assign bilder = bilder | split: '|'
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": {{ 'rezept.schema_start' | t | json }}, "item": {{ request.origin | append: routes.root_url | json }} },
    { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ request.origin | append: blog.url | json }} },
    { "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": {{ seite | json }} }
  ]
}
</script>
{%- if schritte != blank %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": {{ article.title | json }},
  "description": {{ beschreibung | json }},
  {%- if bilder.size > 0 %}
  "image": {{ bilder | json }},
  {%- endif %}
  "author": { "@type": "Person", "name": {{ article.author | json }} },
  "publisher": { "@type": "Organization", "name": {{ shop.name | json }} },
  "recipeCategory": "Kaffeerezept",
  "recipeCuisine": "Coffee",
  {%- if basis.recipe_yield.value != blank %}
  "recipeYield": {{ basis.recipe_yield.value | json }},
  {%- endif %}
  {%- if total != blank %}
  "totalTime": {{ total | json }},
  {%- endif %}
  {%- if prep != blank %}
  "prepTime": {{ prep | json }},
  {%- endif %}
  "datePublished": {{ article.published_at | date: '%Y-%m-%d' | json }},
  "dateModified": {{ geaendert | date: '%Y-%m-%d' | json }},
  {%- if article.tags.size > 0 %}
  "keywords": {{ article.tags | join: ', ' | json }},
  {%- endif %}
  {%- if anzahl > 0 and mf.rating_average.value != blank %}
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ mf.rating_average.value | json }},
    "ratingCount": {{ anzahl | json }},
    "bestRating": "5",
    "worstRating": "1"
  },
  {%- endif %}
  {%- if naehrwerte != blank %}
  "nutrition": {
    "@type": "NutritionInformation"
    {%- if naehrwerte.serving_size.value != blank %}, "servingSize": {{ naehrwerte.serving_size.value | json }}{% endif %}
    {%- if naehrwerte.calories_kcal.value != blank %}, "calories": {{ naehrwerte.calories_kcal.value | append: ' kcal' | json }}{% endif %}
    {%- if naehrwerte.fat_content.value != blank %}, "fatContent": {{ naehrwerte.fat_content.value | append: ' g' | json }}{% endif %}
    {%- if naehrwerte.carbohydrate_content.value != blank %}, "carbohydrateContent": {{ naehrwerte.carbohydrate_content.value | append: ' g' | json }}{% endif %}
    {%- if naehrwerte.protein_content.value != blank %}, "proteinContent": {{ naehrwerte.protein_content.value | append: ' g' | json }}{% endif %}
  },
  {%- endif %}
  "recipeIngredient": [
    {%- assign erste = true -%}
    {%- for s in schritte -%}
      {%- for z in s.step_ingredients.value -%}
        {%- capture zutat -%}{{ z.amount.value }}{% if z.unit.value != blank %} {{ z.unit.value }}{% endif %} {{ z.ingredient_name.value }}{% if z.note.value != blank %} ({{ z.note.value }}){% endif %}{%- endcapture -%}
        {%- unless erste %},{% endunless %}
    {{ zutat | strip | replace: '  ', ' ' | json }}
        {%- assign erste = false -%}
      {%- endfor -%}
    {%- endfor %}
  ],
  "recipeInstructions": [
    {%- for s in schritte -%}
      {%- liquid
        if s.title.value != blank
          assign name = s.title.value
        else
          assign name = 'rezept.schritt' | t: nummer: forloop.index
        endif
        assign text = s.instruction.value | replace: '</p>', '</p> ' | replace: '<br>', ' ' | strip_html | strip_newlines | replace: '  ', ' ' | strip
      -%}
    {
      "@type": "HowToStep",
      "name": {{ name | json }},
      "url": {{ seite | append: '#schritt-' | append: forloop.index | json }},
      "text": {{ text | json }}
      {%- if s.step_image.value != blank -%},
      "image": {{ s.step_image.value | image_url: width: 1200 | prepend: 'https:' | json }}
      {%- endif %}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ]
  {%- if equipment.items.value != blank -%},
  "tool": [
    {%- for e in equipment.items.value -%}
    { "@type": "HowToTool", "name": {{ e.tool_name.value | json }} }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
  {%- endif %}
}
</script>
{%- endif %}
{%- if fragen != blank %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- assign erste = true -%}
    {%- for f in fragen -%}
      {%- if f.question.value != blank and f.answer.value != blank -%}
        {%- unless erste %},{% endunless %}
    {
      "@type": "Question",
      "name": {{ f.question.value | strip | json }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ f.answer.value | replace: '</p>', '</p> ' | strip_html | strip_newlines | replace: '  ', ' ' | strip | json }} }
    }
        {%- assign erste = false -%}
      {%- endif -%}
    {%- endfor %}
  ]
}
</script>
{%- endif %}
