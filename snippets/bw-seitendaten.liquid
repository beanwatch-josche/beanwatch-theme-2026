{%- comment -%}
  Was die Skripte aus der Werkstatt über die Seite wissen müssen.

  BW_SEITE   Navigationsschlüssel wie im Prototyp (start, espresso,
             filterkaffee, decaf, wissen, shop). Verglichen wird über IDs
             und Vorlagen-Suffixe, nicht über Handles, denn die sind in
             Englisch und Französisch übersetzt.
  BW_PLAN    Der Start-Modus (start.js): je Guide-Blog die veröffentlichten
             Artikel. Shopify liefert in blogs[…].articles nur
             Veröffentlichtes, ein fehlender Blog ergibt {} und damit
             «nichts sichtbar».
  BW_ROUTEN  Adressen für den Warenkorb, mit Sprachpräfix (/en, /fr).
  BW_TEXTE   Texte für bw-theme.js aus den Sprachdateien.
{%- endcomment -%}
{%- capture bw_seite -%}{%- render 'bw-navschluessel' -%}{%- endcapture -%}
{%- liquid
  assign guide_blogs = 'brew-guides,barista-guides' | split: ','
-%}
<script>
  window.BW_SEITE = {{ bw_seite | json }};
  window.BW_PLAN = {
    {%- comment -%} Fehlt ein Blog, bleibt sein Eintrag {} (nichts sichtbar). {%- endcomment -%}
    {%- for h in guide_blogs -%}
      {{ h | json }}: {
        {%- if blogs[h] != blank -%}
          {%- for a in blogs[h].articles -%}{%- if a.handle != blank -%}{{ a.handle | json }}: "sichtbar", {% endif -%}{%- endfor -%}
        {%- endif -%}
      }{%- unless forloop.last -%}, {% endunless -%}
    {%- endfor -%}
  };
  window.BW_ROUTEN = {
    start: {{ routes.root_url | json }},
    alle: {{ routes.collections_url | json }},
    warenkorb: {{ routes.cart_url | json }},
    hinzufuegen: {{ routes.cart_add_url | json }},
    aendern: {{ routes.cart_change_url | json }}
  };
  window.BW_WAEHRUNG = {{ cart.currency.iso_code | json }};
  window.BW_TEXTE = {
    leer: {{ 'warenkorb.leer' | t | json }},
    weiter_einkaufen: {{ 'warenkorb.weiter_einkaufen' | t | json }},
    entfernen: {{ 'warenkorb.entfernen' | t | json }},
    weniger: {{ 'warenkorb.weniger' | t | json }},
    mehr: {{ 'warenkorb.mehr' | t | json }},
    anzahl: {{ 'warenkorb.anzahl' | t | json }},
    fehler: {{ 'warenkorb.fehler' | t | json }}
  };
</script>
