{%- comment -%}
  Preis und Kauf der Kaffeeseite, übertragen aus products/*.html der
  Werkstatt (Entscheid 06.10.2026: Wahl über dem Knopf).

  Ohne Abo-Pläne gibt es nur den Knopf: heute, bis die App «Shopify
  Subscriptions» installiert ist, und danach bei Jaguara Summer, der nicht
  im Abo ist. Mit Plänen erscheinen «Einmal kaufen» und «Im Abo» mit dem
  Preis aus selling_plan_allocations, dazu das Intervall. produkt.js
  (kaufwahl) schreibt die Plan-ID ins Feld selling_plan und sperrt es bei
  «Einmal», damit es nicht mitgeht. bw-theme.js fängt das Absenden ab und
  öffnet die Schublade. Ohne JavaScript bleibt es beim Einmalkauf.

  Der Abo-Preis kommt aus dem ersten Plan. Alle Intervalle haben denselben
  Preis; bekämen sie verschiedene Rabatte, müsste die Preiszeile dem
  gewählten Intervall folgen.

  Seit 09.10.2026 (Entscheid Joscha, vorher 10 % günstiger) kostet das Abo
  gleich viel wie der Einmalkauf, dafür ist der Versand jeder Abo-Lieferung
  geschenkt: Das macht der automatische Rabatt «Abo: Versand geschenkt» im
  Shop, nur für Abos. Den Hinweis dazu schaltet die Theme-Einstellung
  abo_versand_geschenkt (ohne Wert gilt sie als an). Mit Prozentrabatt im
  Plan nennt der Hinweis beides.

  Die Pläne legt die App an (Plan «Kaffee-Abo», seit 09.10.2026) und nennt
  die Intervalle «Zustellung alle 4 Wochen», übersetzt «Delivery every 4
  weeks» und «Livraison toutes les 4 semaines». Die Auswahl zeigt sie wie der
  Prototyp hinter «Lieferung alle» nur als «4 Wochen»: Der Anfang aus
  produkt.intervall_praefix fällt weg. Beginnt ein Name anders (etwa nach
  einer Änderung in der App), erscheint er ganz. Vorgewählt sind 4 Wochen.

  p          das Produkt
  zusatz     statt des Grundpreises unter dem Preis, etwa beim Buch
             «220 Seiten · 21 × 27 cm» (seit 0.6.0)
  link_url   zweiter Knopf neben «In den Warenkorb», etwa «Zur
  link_text  Kaffeegeschichte» beim Buch (seit 0.6.0)
  Aufruf: {%- render 'bw-kaufwahl', p: product -%}
{%- endcomment -%}
{%- liquid
  assign v = p.selected_or_first_available_variant
  assign plaene = v.selling_plan_allocations
  assign mit_abo = false
  if v.available and plaene.size > 0
    assign mit_abo = true
  endif
  capture grund_einmal
    render 'bw-grundpreis', preis: v.price, v: v
  endcapture
  assign grund_einmal = grund_einmal | strip
  if zusatz != blank
    assign grund_einmal = zusatz | escape
  endif
-%}
<div class="preiszeile">
  <span class="preis" data-kaufwahl-preis>{{ v.price | money }}</span>
  {%- if grund_einmal != blank %}
  <span class="grundpreis" data-kaufwahl-grundpreis>{{ grund_einmal }}</span>
  {%- endif %}
</div>
{%- form 'product', p, id: 'produkt-form', class: 'bw-kaufform' %}
  {%- if p.variants.size > 1 %}
  {%- comment -%} Mehrere Varianten (etwa Zubehör): Auswahl mit Preis, ohne JavaScript nutzbar. {%- endcomment %}
  <label class="bw-feld">
    <span>{{ p.options.first }}</span>
    <select name="id">
      {%- for w in p.variants %}
      <option value="{{ w.id }}"{% if w.id == v.id %} selected{% endif %}{% unless w.available %} disabled{% endunless %}>{{ w.title }} · {{ w.price | money }}</option>
      {%- endfor %}
    </select>
  </label>
  {%- else %}
  <input type="hidden" name="id" value="{{ v.id }}">
  {%- endif %}
  {%- if mit_abo -%}
    {%- liquid
      assign erste = plaene.first
      capture grund_abo
        render 'bw-grundpreis', preis: erste.price, v: v
      endcapture
      assign grund_abo = grund_abo | strip
      assign rabatt = ''
      assign anpassung = erste.selling_plan.price_adjustments.first
      if anpassung.value_type == 'percentage' and anpassung.value > 0
        assign rabatt = anpassung.value
      endif
      assign versand = true
      if settings.abo_versand_geschenkt == false
        assign versand = false
      endif
    -%}
  <div class="kaufwahl" id="kaufwahl">
    <label class="kaufwahl-option ist-aktiv" data-grundpreis="{{ grund_einmal }}">
      <input type="radio" name="kaufart" value="einmal" checked>
      <span class="kaufwahl-text"><strong>{{ 'produkt.einmal' | t }}</strong></span>
      <span class="kaufwahl-preis">{{ v.price | money }}</span>
    </label>
    <label class="kaufwahl-option" data-grundpreis="{{ grund_abo }}">
      <input type="radio" name="kaufart" value="abo">
      <span class="kaufwahl-text"><strong>{{ 'produkt.abo' | t }}</strong><span class="kaufwahl-hinweis">
        {%- if rabatt != blank and versand -%}{{ 'produkt.abo_hinweis_beides' | t: rabatt: rabatt }}
        {%- elsif rabatt != blank -%}{{ 'produkt.abo_hinweis' | t: rabatt: rabatt }}
        {%- elsif versand -%}{{ 'produkt.abo_hinweis_versand' | t }}
        {%- else -%}{{ 'produkt.abo_hinweis_ohne' | t }}{%- endif -%}
      </span></span>
      <span class="kaufwahl-preis">{{ erste.price | money }}</span>
    </label>
    <div class="kaufwahl-intervall" hidden>
      <label for="kaufwahl-intervall">{{ 'produkt.intervall' | t }}</label>
      <select id="kaufwahl-intervall">
        {%- assign praefix = 'produkt.intervall_praefix' | t | strip -%}
        {%- for a in plaene -%}
          {%- assign intervall = a.selling_plan.options.first.value | default: a.selling_plan.name -%}
          {%- assign anfang = intervall | slice: 0, praefix.size -%}
          {%- if praefix != blank and anfang == praefix -%}
            {%- assign intervall = intervall | remove_first: praefix | strip -%}
          {%- endif %}
        <option value="{{ a.selling_plan.id }}"{% if a.selling_plan.name contains '4 ' %} selected{% endif %}>{{ intervall }}</option>
        {%- endfor %}
      </select>
    </div>
    <input type="hidden" name="selling_plan" value="" disabled>
  </div>
  {%- endif %}
  <div class="kaufreihe">
    <button type="submit" class="btn btn--primaer"{% unless v.available %} disabled{% endunless %} data-pfeil>
      {%- if v.available -%}{{ 'produkt.in_den_warenkorb' | t }}{%- else -%}{{ 'produkt.ausverkauft' | t }}{%- endif -%}
    </button>
    {%- if link_url != blank %}
    <a class="btn btn--linie" href="{{ link_url }}">{{ link_text | escape }}</a>
    {%- endif %}
  </div>
{%- endform %}
