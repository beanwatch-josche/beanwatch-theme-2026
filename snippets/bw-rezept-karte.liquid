{%- comment -%}
  Rezeptkarte für «Passt dazu», Markup wie BWWissen.karte in wissen.js.
  Aufruf: {%- render 'bw-rezept-karte', a: artikel -%}
{%- endcomment -%}
{%- liquid
  assign text = a.excerpt | default: a.content | strip_html | strip | truncatewords: 18
  assign schnitt = a.metafields.custom.rating_average.value
  assign anzahl = a.metafields.custom.rating_count.value | default: 0 | plus: 0
-%}
<a class="beitrag" href="{{ a.url }}" data-art="rezept">
  {%- if a.image %}
  <span class="beitrag-bild">{{ a.image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '320, 480, 640', sizes: '(min-width: 900px) 30vw, 100vw', alt: '' }}</span>
  {%- else %}
  <span class="beitrag-bild ist-leer"><svg viewBox="0 0 24 24" fill="none" stroke="#004B5C" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
  {%- endif %}
  <span class="beitrag-koerper">
    <span class="beitrag-art beitrag-art--rezept"><i class="punkt"></i>{{ 'rezept.art' | t }}</span>
    <h3>{{ a.title }}</h3>
    <p>{{ text }}</p>
    <span class="fusszeile"><span>{% render 'bw-datum', datum: a.published_at %}</span>
      {%- if anzahl > 0 and schnitt != blank -%}
      <span>★ {% render 'bw-zahl', wert: schnitt, stellen: 1 %}</span>
      {%- endif -%}
    </span>
  </span>
</a>
