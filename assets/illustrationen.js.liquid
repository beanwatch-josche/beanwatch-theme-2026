/* ==========================================================================
   Beanwatch · SVG-Illustrationen
   Selbst gezeichnet, in Markenfarben, ohne externe Bibliothek.

   Zwei Familien:
     bwGlas()   Getränke im Schnitt, Schichten wachsen von unten hoch
     bwGeraet() Brühgeräte als Linienzeichnung, Pfade lassen sich zeichnen

   Alle Schichten tragen die Klasse .schicht mit transform-origin unten,
   alle Konturen die Klasse .strich. Darauf setzen die GSAP-Timelines auf.
   ========================================================================== */

(function (global) {
  'use strict';

  /* --- Farben, streng nach CI ---------------------------------------------
     Milch übernimmt Hellorange, Konturen stehen in Dunkelblau. Für Kaffee
     selbst gibt es keine Markenfarbe, deshalb zwei warme Brauntöne, die
     zwischen Redorange und Dunkelblau nicht fremd wirken. */
  const F = {
    kontur:   '#004B5C',
    espresso: '#4A2A1C',
    crema:    '#C98A4B',
    milch:    '#FFF3E8',
    schaum:   '#FFFFFF',
    filter:   '#8B4A26',
    eis:      '#4FC4E2',
    signal:   '#FF4612',
    papier:   '#FFF3E8'
  };

  /* ======================================================================
     Getränke
     ====================================================================== */

  /* Gefässformen. Innenraum als Pfad für den Clip, Aussenlinie als Kontur.
     Koordinatensystem einheitlich 0 0 100 132, Standlinie bei y = 122. */
  const GEFAESSE = {
    // Kleine, dickwandige Espressotasse
    espressotasse: {
      innen: 'M30 62 L70 62 L66 104 Q65 110 58 110 L42 110 Q35 110 34 104 Z',
      aussen: 'M28 58 L72 58 L67.5 105 Q66 114 58 114 L42 114 Q34 114 32.5 105 Z',
      henkel: 'M72 68 Q86 68 86 80 Q86 92 71.5 93',
      untertasse: 'M18 118 L82 118 Q80 124 72 124 L28 124 Q20 124 18 118 Z',
      boden: 122
    },
    // Cappuccino-Tasse, breiter und bauchiger
    tasse: {
      innen: 'M24 52 L76 52 L71 102 Q70 109 61 109 L39 109 Q30 109 29 102 Z',
      aussen: 'M22 48 L78 48 L72.5 103 Q71 113 61 113 L39 113 Q29 113 27.5 103 Z',
      henkel: 'M78 60 Q94 60 94 74 Q94 88 77.5 89',
      untertasse: 'M14 117 L86 117 Q84 124 75 124 L25 124 Q16 124 14 117 Z',
      boden: 122
    },
    // Hohes Glas für Latte Macchiato und Eiskaffee
    glas: {
      innen: 'M33 26 L67 26 L65 108 Q65 112 61 112 L39 112 Q35 112 35 108 Z',
      aussen: 'M31 22 L69 22 L66.5 109 Q66 116 61 116 L39 116 Q34 116 33.5 109 Z',
      henkel: null,
      untertasse: null,
      boden: 122
    },
    // Tumbler für Cortado und Espresso Tonic
    tumbler: {
      innen: 'M31 48 L69 48 L67 106 Q67 110 63 110 L37 110 Q33 110 33 106 Z',
      aussen: 'M29 44 L71 44 L68.5 107 Q68 115 62 115 L38 115 Q32 115 31.5 107 Z',
      henkel: null,
      untertasse: null,
      boden: 122
    }
  };

  /**
   * Zeichnet ein Getränk im Schnitt.
   * @param {object} o
   * @param {string} o.gefaess   Schlüssel aus GEFAESSE
   * @param {Array}  o.schichten Von unten nach oben: {anteil, farbe, name}
   *                             anteil ist der Anteil der Innenhöhe (Summe ≤ 1)
   * @param {boolean} o.eis      Eiswürfel einzeichnen
   * @param {string} o.id        Präfix für die IDs, muss je Seite eindeutig sein
   */
  function bwGlas(o) {
    const g = GEFAESSE[o.gefaess] || GEFAESSE.tasse;
    const id = o.id || ('glas' + Math.random().toString(36).slice(2, 8));

    // Innenraum ausmessen, damit die Schichten passgenau stapeln.
    // Die Werte stammen aus den Pfaden oben: oben ist die erste y-Angabe,
    // unten die Standfläche des Innenraums.
    const grenzen = {
      espressotasse: { oben: 62, unten: 110 },
      tasse:         { oben: 52, unten: 109 },
      glas:          { oben: 26, unten: 112 },
      tumbler:       { oben: 48, unten: 110 }
    }[o.gefaess] || { oben: 52, unten: 109 };

    const hoehe = grenzen.unten - grenzen.oben;

    // Schichten von unten stapeln. Jede bekommt oben eine feine Kante,
    // sonst verschwimmen Milch und Schaum auf hellem Grund ineinander.
    let y = grenzen.unten;
    const schichten = (o.schichten || []).map((s, i) => {
      const h = hoehe * s.anteil;
      y -= h;
      const oben = y;
      return `<g class="schicht-gruppe">
        <rect class="schicht" data-schicht="${i}" data-name="${s.name || ''}"
          x="18" y="${oben.toFixed(2)}" width="64" height="${(h + 0.6).toFixed(2)}"
          fill="${s.farbe}" style="transform-origin:50% ${(oben + h).toFixed(2)}px"/>
        <line class="schichtkante" x1="18" y1="${oben.toFixed(2)}" x2="82" y2="${oben.toFixed(2)}"
          stroke="${F.kontur}" stroke-width="1.1" opacity=".28"/>
      </g>`;
    }).join('');

    const eis = o.eis ? `
      <g class="eis" opacity=".72">
        <rect x="40" y="${grenzen.oben + 8}" width="13" height="13" rx="3" fill="${F.eis}"
              transform="rotate(-14 46 ${grenzen.oben + 14})"/>
        <rect x="52" y="${grenzen.oben + 20}" width="12" height="12" rx="3" fill="${F.eis}"
              transform="rotate(9 58 ${grenzen.oben + 26})"/>
        <rect x="38" y="${grenzen.oben + 30}" width="11" height="11" rx="3" fill="${F.eis}"
              transform="rotate(22 43 ${grenzen.oben + 35})"/>
      </g>` : '';

    return `
<svg class="illu getraenk-svg" viewBox="0 0 100 132" fill="none" role="img"
     aria-label="${o.alt || 'Kaffeegetränk im Schnitt'}">
  <defs>
    <clipPath id="${id}-innen"><path d="${g.innen}"/></clipPath>
  </defs>

  ${g.untertasse ? `<path class="strich unterteller" d="${g.untertasse}" fill="${F.papier}" stroke="${F.kontur}" stroke-width="2.6"/>` : ''}
  ${g.henkel ? `<path class="strich henkel" d="${g.henkel}" stroke="${F.kontur}" stroke-width="2.6"/>` : ''}

  <g clip-path="url(#${id}-innen)">
    ${schichten}
    ${eis}
  </g>

  <path class="strich gefaess" d="${g.aussen}" stroke="${F.kontur}" stroke-width="2.8"/>
</svg>`;
  }

