  // Ein Kaffeeblatt, angesetzt am Ast und nach aussen zeigend.
  function zweigBlatt(x, y, winkel, l) {
    const b = l * 0.38;
    return `<g transform="translate(${x} ${y}) rotate(${winkel})">
      <path class="strich" d="M0 0 Q${l * 0.5} ${-b} ${l} 0 Q${l * 0.5} ${b} 0 0"
            stroke="${H}" stroke-width="2.4"/>
