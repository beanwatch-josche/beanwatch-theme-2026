  // Kaffeekirschen wachsen nicht einzeln, sondern in Trauben dicht am Ast,
  // genau dort, wo die Blätter ansetzen. Sechs Beeren je Knoten, leicht
  // versetzt und überlappend; spiegel legt die Traube auf die andere Seite.
  const TRAUBE = [[-2, -6, 7], [10, -9, 6.2], [4, 4, 7.6], [16, 1, 6.6], [-4, 8, 6.2], [10, 13, 6.6]];

  function zweigTraube(x, y, s, spiegel) {
    const m = spiegel ? -1 : 1;
    const rd = (n) => Math.round(n * 10) / 10;
    return TRAUBE.map(([bx, by, r]) =>
      `<circle class="kirsche" cx="${rd(x + m * bx * s)}" cy="${rd(y + by * s)}" r="${rd(r * s)}"
               fill="${F.signal}" stroke="${H}" stroke-width="2"/>`).join('');
  }

