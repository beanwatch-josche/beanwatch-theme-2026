    // Die Enden des Griffs stecken im Konus, dessen Fuellung sie abdeckt.
    const griff = 'M142.6 179.1 L151.6 179.5 Q156.3 179.9 156.2 184.4 ' +
                  'Q156 187.4 153.2 189.5 L131 201.8';

    return `<svg class="v60" viewBox="0 0 228 220" fill="none" aria-hidden="true">
  <g class="v60-wippe" stroke="${K}" stroke-linecap="round" stroke-linejoin="round">${strahl}
