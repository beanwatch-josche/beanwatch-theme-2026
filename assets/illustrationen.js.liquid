  function bwPappsticker(o) {
    const m = PAPP_MOTIVE[(o && o.motiv) || 'sup'];
    const k = m.kontur, logo = m.logo;
    const vb = [k.x - m.rand, k.y - m.rand, k.breite + 2 * m.rand,
                k.hoehe + m.dicke + 2 * m.rand].map((n) => n.toFixed(1)).join(' ');
    const linie = ' stroke="' + F.kontur + '" stroke-width="3" stroke-linejoin="round" vector-effect="non-scaling-stroke"';
    return `<svg class="pappsticker" viewBox="${vb}" fill="none" aria-hidden="true">
    <g class="sticker-dreh">
      <path class="sticker-kante" d="${k.d}" transform="translate(0 ${m.dicke})" fill="${m.kante}"${linie}/>
      <path class="sticker-flaeche" d="${k.d}" fill="${m.flaeche}"${linie}/>
      <image href="${logo.datei}" x="${logo.x}" y="${logo.y}" width="${logo.breite}" height="${logo.hoehe}"/>
    </g>
  </svg>`;
  }

  // Der Drehpunkt der Hand je Motiv. bwPappsticker.hand bleibt der des SUP,
  // so liest ihn hubs.js.
  function pappHand(m) {
    const k = m.kontur;
    const x = k.fuss.x + k.fuss.breite / 2;
    const y = k.fuss.y + k.fuss.hoehe;
    const links = k.x - m.rand, oben = k.y - m.rand;
    const breite = k.breite + 2 * m.rand, hoehe = k.hoehe + m.dicke + 2 * m.rand;
    return {
      punkt: x.toFixed(1) + ' ' + y.toFixed(1),
      anteil: ((x - links) / breite * 100).toFixed(1) + '% ' + ((y - oben) / hoehe * 100).toFixed(1) + '%'
    };
  }
  bwPappsticker.haende = {
    sup: pappHand(PAPP_MOTIVE.sup),
    jetski: pappHand(PAPP_MOTIVE.jetski),
    fernglas: pappHand(PAPP_MOTIVE.fernglas)
  };
  bwPappsticker.hand = bwPappsticker.haende.sup;

