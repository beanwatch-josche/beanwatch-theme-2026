  function bwRettungsarm(o) {
    o = o || {};
    const mitSchaum = o.schaum !== false;
    const ende = o.armEnde || 206;
    const strich = (farbe, breite) =>
      `    <path d="M72.5 ${ende} V101.8"` +
      (farbe ? ` stroke="${farbe}"` : '') + ` stroke-width="${breite}"/>\n`;
    return ARM_KOPF + (mitSchaum ? ARM_SCHAUM : '') + ARM_DREH_AUF +
           strich(null, 27) + strich('#FFFFFF', 21) + ARM_REST;
  }

  /* ======================================================================
     Kaffeetasse im Profil, fuer die Szene neben dem Rettungsarm
     ======================================================================

     ACHTUNG, es gibt zwei Tassen im Haus. Das hier ist die Tasse als
     Silhouette, fuer eine Szene. Die Tasse im SCHNITT, mit gestapelten
     Schichten Milch und Kaffee darin, ist bwGlas({gefaess:'tasse'}).

     DIESELBE viewBox WIE DER ARM, 228 mal 220. Das ist der ganze Trick
     dieser Zeichnung, und er spart drei Rechnungen:

     1. Gleich dicke Linien. Steht die Tasse im CSS auf derselben Breite wie
        der Arm, rendern beide 0,616 / 228 Pixel je Einheit mal --szene. Ein
        stroke-width="3" ist dann beweisbar gleich dick, und die Probe ist
        eine Gleichung statt einer Rechnung: gleiche offsetWidth.
     2. Gleiche Hoehen. Bei gleichem bottom liegen die y-Werte beider
        Zeichnungen aufeinander. Die Tuellenmitte steht bei y 142, der
        Tassenrand bei y 194, also 52 Einheiten darunter, bei jeder
        Fensterbreite und ohne eine Zeile Code.
     3. Die Fahrt. Die Tasse sitzt mittig auf x 114, also ist die Mitte des
        Kastens die Mitte der Tasse. Genau so macht es bwFaehre() mit
        viewBox="-50 0 600 140" und dem Schiff auf 250.

     Der Kasten ist dabei zu drei Vierteln leer. Das kostet nichts,
     .szene-spur steht auf pointer-events:none.

     Gezeichnet im Strich des Wasserkessels: Kontur #004B5C, Flaeche
     #FFFFFF, Strichstaerke 3 an Koerper und Henkel, 2.4 an der Randlinie
     wie an den Rippen des Kessels. Gerader Rand als erste Linie des
     Pfades, Trapez mit Q-Ecken unten, Henkel als doppelter Q-Bogen. So ist
     im Haus jede Tasse gezeichnet, siehe bwSiebtraeger(). Keine Ellipse,
     die gehoert zur Prozessfamilie.

     Masse: Rand 50 Einheiten breit, Koerper 48 hoch. Am Kesselkorpus
     gemessen (88 mal 84) sind das in beiden Richtungen 57 Prozent. Im
     Massstab der Szene rund 9 cm neben einem Kessel mit 1,2 Litern.

     Der Henkel zeigt nach LINKS, weg vom Kessel, damit der Rand offen zur
     Tuelle steht. Dieses SVG bekommt deshalb KEIN scaleX(-1), anders als
     der Arm. Eine Spiegelung kehrte auch die Drehrichtung des Wippens um.

     Die Wand laeuft weiter, als man sieht, per Schalter ende. Ein
     Tassenboden ueber dem Wasser sieht nicht aus wie schwimmen, sondern wie
     ein Fehler. Dieselbe Loesung wie armEnde beim Unterarm. Voreinstellung
     242, der wirkliche Boden. In der Wasserszene steht 280, dann liegt der
     Boden auch im tiefsten Wellental noch mindestens 36 px unter Wasser.

     Der Henkel kommt VOR den Koerper, damit dessen weisse Fuellung die
     Ansatzstellen abdeckt. Genauso macht es bwGlas(). */
  function bwTasse(o) {
    o = o || {};
    const ende = o.ende || 242;

    /* Wandneigung: Rand 50 breit, Boden 40, ueber 48 Einheiten Hoehe. Aus
       dieser einen Zahl folgen alle Wandpunkte, auch die Henkelansaetze. */
    const NEIGUNG = 0.10417;
    const ECKE = 8;
    const rechts = (y) => (139 - (y - 194) * NEIGUNG).toFixed(1);
    const links = (y) => (89 + (y - 194) * NEIGUNG).toFixed(1);

    const koerper =
      `M89 194 L139 194 L${rechts(ende - ECKE)} ${ende - ECKE} ` +
      `Q${rechts(ende)} ${ende} ${(+rechts(ende) - ECKE).toFixed(1)} ${ende} ` +
      `L${(+links(ende) + ECKE).toFixed(1)} ${ende} ` +
      `Q${links(ende)} ${ende} ${links(ende - ECKE)} ${ende - ECKE} Z`;

    /* Kaffee darin, als Schalter und standardmaessig aus. Eine Tasse voll
       Kaffee schwimmt nicht, und erzaehlerisch ist sie leer: Der Kessel
       kommt ja, um sie zu fuellen. Der transform-origin liegt unten, damit
       ein Einguss spaeter von unten wachsen kann. */
    const kaffee = o.kaffee
      ? `    <path class="tasse-kaffee" d="M93.2 201 L134.8 201 ` +
        `L${rechts(ende - 4)} ${ende - 4} L${links(ende - 4)} ${ende - 4} Z" ` +
        `fill="#4A2A1C" stroke="none" style="transform-origin:50% ${ende - 4}px"/>\n`
      : '';

    return `<svg class="tasse" viewBox="0 0 228 220" fill="none" aria-hidden="true">
  <g class="tasse-wippe" stroke="#004B5C" stroke-linecap="round" stroke-linejoin="round">
    <path class="tasse-henkel" d="M89.6 200 Q72 200 72 213 Q72 226 92.3 226" stroke-width="3"/>
    <path class="tasse-koerper" d="${koerper}" fill="#FFFFFF" stroke-width="3"/>
${kaffee}    <path class="tasse-randlinie" d="M93.5 199 Q114 202.5 134.5 199" stroke-width="2.4"/>
  </g>
</svg>`;
  }

  /* ======================================================================
     V60-Filterkopf aus Keramik, im Profil, fuer die Szene neben dem Arm
     ======================================================================

     Entwurf vom 04.10.2026 im Filterkopf-Labor: Statt der Tasse schwimmt
     der Hario V60 02 aus Keramik auf dem Wasser. Nachgezeichnet nach einem
     Produktfoto von Joscha: Die Umrisse sind Zeile fuer Zeile aus dem Foto
     vermessen, Randbreite 1364 px gleich 64 Einheiten.

     Gebaut wie bwTasse(): DIESELBE viewBox WIE DER ARM, 228 mal 220, mittig
     auf x 114, gleiche Farben und Strichstaerken. Die Tassenspur kann ihn
     deshalb ohne eine Zeile CSS tragen, und seine Linien sind so dick wie
     die des Kessels.

     Von oben nach unten, wie auf dem Foto:
       Rand        y 174, 64 Einheiten breit, mit schmaler Lippe
       Konus       Flanken bis y 211, dann eingezogen zum Hals. Die Flanken
                   sind nicht gerade: Wie der Kessel hat der Koerper Stufen,
                   nur sehr viel zarter. Im Foto vermessen wechseln sich vier
                   flache Woelbungen mit drei Einschnuerungen ab, bei y 185,
                   195,8 und 206,1. Die Woelbungen stehen 0,45 Einheiten vor
                   der Geraden, die unterste am Hals 0,3. An jeder
                   Einschnuerung eine feine Linie (.v60-stufen, Strich 1,2),
                   so wie die Rippen des Kessels, nur halb so stark.
       Hals        am schmalsten bei y 215, 23 Einheiten breit
       Scheibe     y 216 bis 224, 57 Einheiten breit, oben trompetenfoermig
       Aufsatz     y 224 bis 228, 34 Einheiten breit, sitzt im Wasser
       Griff       rechts, fast dreieckig: oben gerade, aussen eine runde
                   Ecke, schraeg zurueck zum Konus

     Der Griff ist ein Band und gezeichnet wie der Schwanenhals des
     Kessels: derselbe Pfad zweimal, breit in Dunkelblau, schmal in Weiss.
     Ein Umriss aus zwei Konturen ging nicht, das Band ist nur 3 Einheiten
     breit, und zwei Striche von 3 fuellten es ganz.

     Schalter:
       griff   'rechts' wie auf dem Foto (Voreinstellung) oder 'links'. In
               der Szene zeigt er nach links, weg vom Kessel, wie der
               Henkel der Tasse. Gespiegelt wird in einer inneren Gruppe,
               damit die Drehrichtung des Wippens gleich bleibt.
       tiefe   verschiebt die Zeichnung nach unten, in Einheiten. 0 heisst:
               Unterkante der Scheibe auf y 224, der mittleren
               Wasseroberflaeche der Szene.
       strahl  legt den Wasserstrahl aus dem Kessel an, seit 04.10.2026.
               Die Gruppe .v60-strahl liegt zuunterst in .v60-wippe und
               ausserhalb der Spiegelung. So deckt der weisse Koerper das
               Ende des Strahls ab, und er verschwindet oben in der Oeffnung.
               Die drei Pfade sind leer, ihr d setzt hubs.js in jedem Bild
               aus der Lage der Tuelle. Kontur und Cyanblau wie beim
               Schwanenhals doppelt gezogen: Cyanblau allein kaeme auf dem
               Hellorange nur auf 1,86:1. Darauf eine feine weisse
               Strichelung, die nach unten wandert, damit man das Wasser
               fliessen sieht. Duenner als die Tuellenoeffnung, wie bei einem
               Schwanenhals, der langsam giesst.

     Gewippt wird .v60-wippe, sie traegt kein transform-Attribut (die Falle
     mit .arm-faust). Die Praegung «HARIO 02» bleibt weg, weiss auf weiss
     waere sie in dieser Groesse nicht zu sehen. */
  function bwV60(o) {
    o = o || {};
    const K = F.kontur;
    const W = '#FFFFFF';
    const tiefe = o.tiefe || 0;
