  const UFER = { gruen: '#8CB36E', gruenKante: '#6E9656' };

  // bwUfer(breite, hoehe): Mauer und Wiese in echten Pixeln. So behalten die
  // Steine bei jeder Breite ihre Form; bei neuer Breite wird neu gezeichnet.
  // Der Zufall hat einen festen Startwert, dieselbe Breite ergibt dieselben
  // Steine.
  function bwUfer(breite, hoehe) {
    const w = Math.max(1, Math.round(breite));
    const h = Math.max(1, Math.round(hoehe));
    const K = F.kontur;
    const mauer = Math.round(h * 0.46);
    const krone = Math.max(6, Math.round(mauer * 0.17));
    const reihen = 2;
    const reihe = (mauer - krone) / reihen;

    let saat = 11;
    const zufall = () => { saat = (saat * 16807) % 2147483647; return (saat - 1) / 2147483646; };
    const z = (n) => n.toFixed(1);

    let steine = '';
    for (let r = 0; r < reihen; r++) {
      const y = krone + r * reihe;
      let x = r % 2 ? -reihe * 0.9 : -reihe * 0.3;
      while (x < w) {
        const b = reihe * (1.35 + zufall() * 1.4);
        steine += `<rect x="${z(x + 1.3)}" y="${z(y + 1.3)}" width="${z(b - 2.6)}" height="${z(reihe - 2.6)}"
                         rx="${z(reihe * 0.3)}" fill="${F.papier}" stroke="${K}" stroke-width="1.5"/>`;
        if (zufall() < 0.35) {
          steine += `<rect x="${z(x + 1.3)}" y="${z(y + 1.3)}" width="${z(b - 2.6)}" height="${z(reihe - 2.6)}"
                           rx="${z(reihe * 0.3)}" fill="${K}" opacity=".07"/>`;
        }
        x += b;
      }
    }

    let halme = '';
    for (let x = 30 + zufall() * 40; x < w; x += 70 + zufall() * 90) {
      const y = mauer + (h - mauer) * (0.35 + zufall() * 0.5);
      halme += `<path d="M${z(x)} ${z(y)} l-3.5 -8 M${z(x)} ${z(y)} l.8 -10.5 M${z(x)} ${z(y)} l5 -7.5"/>`;
    }

    return `<svg viewBox="0 0 ${w} ${h}" width="${w}" height="${h}" preserveAspectRatio="none" aria-hidden="true">
  <rect x="0" y="0" width="${w}" height="${mauer}" fill="${K}" opacity=".32"/>
  ${steine}
  <rect x="-2" y="0" width="${w + 4}" height="${krone}" fill="${F.papier}" stroke="${K}" stroke-width="2"/>
  <rect x="0" y="${mauer}" width="${w}" height="${h - mauer}" fill="${UFER.gruen}"/>
  <path d="M0 ${mauer + 1.5} H${w}" stroke="${UFER.gruenKante}" stroke-width="3"/>
  <g stroke="${K}" stroke-width="1.6" stroke-linecap="round" opacity=".38">${halme}</g>
</svg>`;
  }

  // Der Läufer ist das Signet selbst: bwLaeufer() in laeufer-signet.js,
  // erzeugt von werkzeug/signet-laeufer.rb.

  global.bwProzess = bwProzess;
  global.bwUfer = bwUfer;
  global.bwNote = bwNote;
  global.bwGlas = bwGlas;
  global.bwGeraet = bwGeraet;
  global.bwMaschine = bwMaschine;
  global.bwSiebtraeger = bwSiebtraeger;
  global.bwAufguss = bwAufguss;
  global.bwRettungsarm = bwRettungsarm;
  global.bwTasse = bwTasse;
  global.bwV60 = bwV60;
  global.bwPappsticker = bwPappsticker;
  global.bwFaehre = bwFaehre;
  global.BW_FARBEN = F;
})(window);
