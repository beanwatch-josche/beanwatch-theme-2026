    const strahl = o.strahl ? `
    <g class="v60-strahl" fill="none">
      <path class="v60-strahl-kontur" stroke-width="4.2"/>
      <path class="v60-strahl-wasser" stroke="${F.eis}" stroke-width="2.2"/>
      <path class="v60-strahl-licht" stroke="${W}" stroke-width="0.8" stroke-dasharray="2.4 6.6" opacity=".9"/>
    </g>` : '';

    const koerper =
      'M82.6 174 H145.4 Q146.3 174 146.1 175 L145.3 177.3 ' +
