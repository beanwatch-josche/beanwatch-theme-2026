  function bwNote(name) {
    // Umlaute werden umgeschrieben statt weggeworfen, damit «Früchtetee» und
    // «Fruechtetee» denselben Eintrag finden. Der Shop schreibt sie mal so,
    // mal so; im Text stehen sie richtig, im Schlüssel immer als ae/oe/ue.
    // Danach fallen die übrigen Akzente weg («Pêche» wird «peche»).
    const s = String(name || '').toLowerCase()
      .replace(/ä/g, 'ae').replace(/ö/g, 'oe').replace(/ü/g, 'ue').replace(/ß/g, 'ss')
      .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z]/g, '');
    const n = NOTEN[s] || NOTEN[NOTEN_AUCH[s]] ||
      { farbe: '#C98A4B', blatt: true, form: 'rund', kerbe: false };
    const K = F.kontur;

    let koerper;
    switch (n.form) {
      case 'doppel': // zwei Kirschen an Stielen
        koerper = `<circle cx="17" cy="34" r="10" fill="${n.farbe}" stroke="${K}" stroke-width="2"/>
                   <circle cx="33" cy="37" r="9" fill="${n.farbe}" stroke="${K}" stroke-width="2"/>
                   <path d="M17 24C18 14 24 10 28 8M33 28C32 18 28 12 28 8" stroke="${K}"
                         stroke-width="2" fill="none" stroke-linecap="round"/>`;
        break;
      case 'spitz': // Erdbeere
        koerper = `<path d="M25 46C15 40 10 30 12 23C14 17 20 15 25 15C30 15 36 17 38 23C40 30 35 40 25 46Z"
                         fill="${n.farbe}" stroke="${K}" stroke-width="2"/>
                   <g fill="${K}" opacity=".55">
                     <circle cx="20" cy="25" r="1.4"/><circle cx="30" cy="25" r="1.4"/>
                     <circle cx="25" cy="32" r="1.4"/><circle cx="19" cy="34" r="1.4"/><circle cx="31" cy="34" r="1.4"/>
                   </g>`;
        break;
      case 'tropfen':
        koerper = `<path d="M25 10C25 10 37 26 37 34A12 12 0 0 1 13 34C13 26 25 10 25 10Z"
                         fill="${n.farbe}" stroke="${K}" stroke-width="2"/>`;
        break;
      case 'tafel':
        koerper = `<rect x="11" y="15" width="28" height="26" rx="3" fill="${n.farbe}"
                         stroke="${K}" stroke-width="2"/>
                   <path d="M25 15v26M11 28h28" stroke="${K}" stroke-width="1.8" opacity=".6"/>`;
        break;
      case 'tafelbruch': // Tafel mit abgebrochener Ecke, das Stück daneben (seit 09.10.2026)
        koerper = `<path d="M12 16q0-3 3-3h9v10h12v17q0 3-3 3H15q-3 0-3-3Z" fill="${n.farbe}"
                         stroke="${K}" stroke-width="2" stroke-linejoin="round"/>
                   <path d="M24 23v20M12 23h12M12 33h24" stroke="#7A5236" stroke-width="1.8"/>
                   <g transform="rotate(18 34 11)"><rect x="28.5" y="5.5" width="11" height="10" rx="1.6"
                         fill="${n.farbe}" stroke="${K}" stroke-width="2"/></g>`;
        break;
      case 'bluete':
        koerper = `<g fill="${n.farbe}" stroke="${K}" stroke-width="1.8">
                     <ellipse cx="25" cy="17" rx="6" ry="8"/><ellipse cx="25" cy="37" rx="6" ry="8"/>
                     <ellipse cx="15" cy="27" rx="8" ry="6"/><ellipse cx="35" cy="27" rx="8" ry="6"/>
                   </g><circle cx="25" cy="27" r="5" fill="#FFC000" stroke="${K}" stroke-width="1.8"/>`;
        break;
      case 'oval':
        koerper = `<ellipse cx="25" cy="30" rx="13" ry="11" fill="${n.farbe}" stroke="${K}" stroke-width="2"/>`;
        break;
      case 'mandel': // stehendes Oval, oben spitz
        koerper = `<path d="M25 13C33 20 36 28 34 35C32 42 28 45 25 45C22 45 18 42 16 35C14 28 17 20 25 13Z"
                         fill="${n.farbe}" stroke="${K}" stroke-width="2"/>
                   <path d="M25 19v20" stroke="${K}" stroke-width="1.6" opacity=".45" stroke-linecap="round"/>`;
        break;
      case 'apfel': // runde Frucht mit Delle oben
        koerper = `<path d="M25 20c-3-4-9-4-12 0c-4 5-3 15 1 20c3 4 7 5 11 3c4 2 8 1 11-3c4-5 5-15 1-20
                            c-3-4-9-4-12 0Z" fill="${n.farbe}" stroke="${K}" stroke-width="2"/>`;
        break;
      case 'melone': // aufgeschnittene Hälfte mit Schale
        koerper = `<path d="M11 32a14 14 0 0 1 28 0Z" fill="${n.farbe}" stroke="${K}" stroke-width="2"/>
                   <path d="M15 32a10 10 0 0 1 20 0" stroke="${K}" stroke-width="1.6" fill="none" opacity=".5"/>
                   <path d="M11 32h28" stroke="${K}" stroke-width="2" stroke-linecap="round"/>`;
        break;
      case 'praline': // Kuppel mit Tupfer obendrauf
        koerper = `<path d="M12 38a13 11 0 0 1 26 0Z" fill="${n.farbe}" stroke="${K}" stroke-width="2"/>
                   <path d="M12 38h26" stroke="${K}" stroke-width="2" stroke-linecap="round"/>
                   <path d="M25 27c0-4 3-5 3-8" stroke="${K}" stroke-width="2" fill="none" stroke-linecap="round"/>`;
        break;
      case 'nelke': // Gewürznelke, Knospe oben, Stiel unten
        koerper = `<path d="M25 44V24" stroke="${K}" stroke-width="2" stroke-linecap="round"/>
                   <path d="M25 24c-4 0-7-3-7-7s3-6 7-6s7 3 7 6s-3 7-7 7Z"
                         fill="${n.farbe}" stroke="${K}" stroke-width="2"/>
                   <path d="M18 15l-5-3M32 15l5-3" stroke="${K}" stroke-width="2" stroke-linecap="round"/>`;
        break;
      case 'halm': // Zuckerrohr, Stange mit Knoten
        koerper = `<rect x="19" y="9" width="12" height="34" rx="5" fill="${n.farbe}"
                         stroke="${K}" stroke-width="2"/>
                   <path d="M19 20h12M19 31h12" stroke="${K}" stroke-width="1.8" opacity=".6"/>`;
        break;
      case 'welle': // Milchtropfen im Kreis, für cremig
        koerper = `<circle cx="25" cy="28" r="14" fill="${n.farbe}" stroke="${K}" stroke-width="2"/>
                   <path d="M14 30c4-4 7 4 11 0s7-4 11 0" stroke="${K}" stroke-width="2"
                         fill="none" stroke-linecap="round"/>`;
        break;
      case 'blatt': // Teeblatt, für Früchtetee
        koerper = `<path d="M13 40C11 27 20 14 38 12C39 30 28 41 13 40Z"
                         fill="${n.farbe}" stroke="${K}" stroke-width="2"/>
                   <path d="M13 40C20 33 28 24 38 12" stroke="${K}" stroke-width="1.8"
                         fill="none" stroke-linecap="round" opacity=".6"/>`;
        break;
      case 'haselnuss': // kurze Spitze oben, unten die helle, raue Ansatzfläche
        koerper = `<path d="M25 9c2 3 14 8 14 20 0 8-6 13-14 13s-14-5-14-13c0-12 12-17 14-20Z"
                         fill="${n.farbe}" stroke="${K}" stroke-width="2"/>
                   <path d="M11.4 32c2.6-2 4.6 1 7-.8 2.4-1.8 4.3 1 6.6-.6 2.3 1.6 4.2-1.2 6.6.6
                            2.4 1.8 4.4-1.2 7 .8C37 38 31.6 42 25 42s-12-4-13.6-10Z"
                         fill="#E6CDA3" stroke="${K}" stroke-width="1.8" stroke-linejoin="round"/>
                   <g fill="${K}" opacity=".35"><circle cx="20" cy="37" r="1"/>
                     <circle cx="25" cy="38.5" r="1"/><circle cx="30" cy="37" r="1"/></g>
                   <path d="M19 16c-2 3-3 6-3 9" stroke="#fff" stroke-width="1.8" opacity=".35"
                         stroke-linecap="round"/>`;
        break;
      default: // rund
        koerper = `<circle cx="25" cy="30" r="13" fill="${n.farbe}" stroke="${K}" stroke-width="2"/>` +
          (n.kerbe ? `<path d="M25 18c-3 5-3 19 0 24" stroke="${K}" stroke-width="1.8"
                            fill="none" opacity=".5" stroke-linecap="round"/>` : '');
    }

    const blatt = n.blatt
      ? `<path d="M27 17c3-6 9-8 13-7-1 5-5 9-11 9" fill="#8FAE6A" stroke="${K}" stroke-width="1.8"/>
         <path d="M25 18c0-4 1-6 2-8" stroke="${K}" stroke-width="1.8" fill="none" stroke-linecap="round"/>`
      : '';

    return `<svg class="note-icon" viewBox="0 0 50 50" fill="none" aria-hidden="true">
      ${koerper}${blatt}</svg>`;
  }

  /* ======================================================================
     Die Autofähre Horgen–Meilen
     Seitenansicht, bewusst reduziert. Vorbild ist die MF Horgen der
     Bodan-Werft von 1991: langer flacher Rumpf mit dunklem Unterwasserband,
     trapezförmiger Aufbau, Steuerhaus mit Fensterband und die farbige Linie,
     die an den offenen Decks gestrichelt läuft und über dem Aufbau ansteigt.
     Wer sie einmal auf dem See gesehen hat, erkennt sie an dieser Linie.

     Doppelender wie das Original: vorne und hinten sind gleich, die Fähre
     wendet nie. Deshalb gibt es an beiden Enden Kielwasser, und die
     Animation blendet jeweils das ein, das hinten liegt.

     Koordinaten: Rumpf von x 8 bis 492, Wasserlinie bei y 132. Die viewBox
     reicht links und rechts 50 Einheiten weiter, damit das Kielwasser Platz
     hat. Ihre Mitte bleibt bei x 250, also bei der Schiffsmitte.

     bwFaehre({ name, ladung, akzent })
       name    Schriftzug auf dem Aufbau
       ladung  'saecke', 'beutel' oder 'autos', auf beiden Decks gleich;
               'stapel' oder 'haufen', je Deck verschieden (Startseite seit
               dem 03.10.2026, entstanden in faehren-labor.html).
               'haufen' zeichnet die Beutel mit bwBeutel() aus beutel.js,
               das deshalb vorher geladen sein muss. Fehlt es, fährt die
               Fähre 'beutel'.
       akzent  'signal' (Redorange) oder 'kontur' (Dunkelblau) für Linie
               und Wappen
     ====================================================================== */
  const FAEHRE = {
    jute:     '#C8A46A',
    juteNaht: '#9C7A45',
    // Der Schiffsname steht auf dem Original in Gold.
    gold:     '#B8860B',
    signet:   '{{ 'logo-hellorange-signet.svg' | asset_url }}'
  };

  // Spiegelt ein Ladungsstück, das bei x beginnt und b breit ist, auf das
  // andere Deck. Die Fähre ist um x 250 symmetrisch.
  const gespiegelt = (x, b) => 500 - x - b;

  function faehreAuto(x, farbe) {
    const K = F.kontur;
    return `<path d="M${x} 118 V109 Q${x} 104 ${x + 5} 104 H${x + 35} Q${x + 40} 104 ${x + 40} 109 V118 Z"
                  fill="${farbe}" stroke="${K}" stroke-width="1.4"/>
            <path d="M${x + 8} 104 L${x + 12} 97 H${x + 27} L${x + 31} 104 Z"
                  fill="${farbe}" stroke="${K}" stroke-width="1.4"/>`;
  }

  // Ein liegender Jutesack: bauchig, mit gestrichelter Naht quer drüber.
  function faehreSack(x, y) {
    const K = F.kontur;
    return `<g transform="translate(${x} ${y})">
      <path d="M1 10.5 Q0 12 2.5 12 H29.5 Q32 12 31 10.5 L31.5 3 Q32 .5 28 .8 Q16 -.8 4 .8 Q0 .5 .5 3 Z"
            fill="${FAEHRE.jute}" stroke="${K}" stroke-width="1.4"/>
      <path d="M5 6.2 H27" stroke="${FAEHRE.juteNaht}" stroke-width="1.1" stroke-dasharray="2 1.6"/>
    </g>`;
  }

  // Etiketten wie auf den echten Beuteln, CI-Guide Kapitel Packaging. Der
  // Beutel selbst ist immer Cyan, das Etikett trägt die Identität: Grund,
  // Logo-Motiv der Bohne und Linien in der zweiten Farbe. Die Logos kommen
  // aus der Bibliothek, auf sattem Grund die Reverse-Zeichnung aus
  // hellorange/. Den Jetski in Pink gibt es dort nicht, der Filterkaffee ist
  // aber so gedruckt; pink/ ist deshalb eine Kopie der hellen Zeichnung.
  const ETIKETT = {
    standard:     { grund: F.kontur,  logo: FAEHRE.signet, linien: F.eis },
    hoyoEspresso: { grund: '#E7455B', logo: '{{ 'logo-hellorange-jetski-vertikal.svg' | asset_url }}',   linien: F.papier },
    hoyoFilter:   { grund: F.papier,  logo: '{{ 'logo-pink-jetski-vertikal.svg' | asset_url }}',         linien: '#E7455B' },
    megaduFilter: { grund: F.signal,  logo: '{{ 'logo-hellorange-fernglas-vertikal.svg' | asset_url }}', linien: F.papier }
  };

  // Ein Beanwatch-Beutel: fast quadratisch, Cyan mit Etikett. Links darauf
  // das Logo, rechts statt Name und Tabelle drei feine Linien.
  // 30 × 30 Einheiten, der Boden verschwindet hinter der Bordwand.
  function faehreBeutel(x, art) {
    const K = F.kontur;
    const e = ETIKETT[art] || ETIKETT.standard;
    // Auf dem hellen Etikett braucht es eine Kante, sonst verschwimmt es
    // mit dem Cyan des Beutels.
    const kante = e.grund === F.papier ? ` stroke="${K}" stroke-width=".7"` : '';
    return `<g transform="translate(${x} 85)">
      <path d="M1 33 V7 Q1 3 5 3 H27 Q31 3 31 7 V33 Z"
            fill="${F.eis}" stroke="${K}" stroke-width="1.5"/>
      <path d="M3.5 8.2 H28.5" stroke="${K}" stroke-width="1" opacity=".45"/>
      <rect x="4" y="12.5" width="24" height="14.5" rx="1.6" fill="${e.grund}"${kante}/>
      <image href="${e.logo}" x="5" y="13.3" width="10" height="13"
             preserveAspectRatio="xMidYMid meet"/>
      <path d="M16.5 16.8 H26 M16.5 19.8 H26 M16.5 22.8 H23.4"
            stroke="${e.linien}" stroke-width="1.1" stroke-linecap="round"/>
    </g>`;
  }

  // Ein aufrecht stehender Jutesack mit Schablonendruck der Herkunft:
  // bauchig, oben die zwei abgebundenen Ecken. 30 × 40 Einheiten.
  //
  // Ohne o steht er wie bisher bei y 78 auf dem Deck. Mit o, für 'stapel':
  //   unten   Unterkante (y), mass  Verkleinerung, kipp  Grad um die Mitte
  //   der Unterkante, rahmen  'rechteck' (Standard), 'oval' oder 'linien'.
  // Die Länder rahmen ihren Druck verschieden, damit man sie auch im Hero
  // auseinanderhält, wo die Schrift nur noch ein paar Pixel hoch ist. Die
  // Laufweite richtet sich nach der Wortlänge, sonst würde ein kurzes Wort
  // in die Breite gezogen.
  const SACK_RAHMEN = {
    rechteck: (K) => `<rect x="5" y="14" width="20" height="18" rx="1" fill="none" stroke="${K}" stroke-width=".9"/>`,
    oval:     (K) => `<ellipse cx="15" cy="23" rx="11.5" ry="10" fill="none" stroke="${K}" stroke-width=".9"/>`,
    linien:   (K) => `<path d="M5 14.5 H25 M5 31.5 H25" stroke="${K}" stroke-width=".9"/>`
  };

  function faehreSackAufrecht(x, zeile1, zeile2, o) {
    const K = F.kontur;
    const mass = (o && o.mass) || 1;
    const lage = o
      ? `translate(${x} ${o.unten - 40 * mass}) scale(${mass}) rotate(${o.kipp || 0} 15 40)`
      : `translate(${x} 78)`;
    const rahmen = SACK_RAHMEN[o && o.rahmen] || SACK_RAHMEN.rechteck;
    const lang1 = Math.min(14.5, zeile1.length * 2.1);
    const lang2 = Math.min(16.5, zeile2.length * 2.75);
    return `<g transform="${lage}">
      <path d="M3 40 Q0 40 .8 35 L2 10 Q2.4 6 .8 2.2 L6.5 4.6 Q15 3.2 23.5 4.6 L29.2 2.2
               Q27.6 6 28 10 L29.2 35 Q30 40 27 40 Z"
            fill="${FAEHRE.jute}" stroke="${K}" stroke-width="1.4"/>
      <g fill="${K}" opacity=".88">
        ${rahmen(K)}
        <text x="15" y="20.6" text-anchor="middle" textLength="${lang1}" lengthAdjust="spacingAndGlyphs"
              style="font:800 4.8px Gabarito,'Trebuchet MS',sans-serif">${zeile1}</text>
        <text x="15" y="28.6" text-anchor="middle" textLength="${lang2}" lengthAdjust="spacingAndGlyphs"
              style="font:800 7px Gabarito,'Trebuchet MS',sans-serif">${zeile2}</text>
      </g>
    </g>`;
  }

  /* --- Ladung 'stapel': Rohkaffee aus drei Ländern -----------------------
     Links drei liegende Säcke, darauf zwei in den Lücken, obenauf zwei
     aufrecht von vorne: Brasilien im Rechteck, Kolumbien im Oval, leicht
     zueinander geneigt. Rechts drei liegende, darauf rechts einer, der
     genauso liegt, links daneben aufrecht Äthiopien zwischen zwei Linien,
     mit der Region Guji wie unsere Guji-Kaffees. Auf Portugiesisch heisst
     es «Café do Brasil», die Mehrzahl wäre «Cafés do Brasil».

     Die unterste Lage liegt bei y 103, fast ganz über der Bordwand (y 114).
     Bei 106 wie in 'saecke' sähe man von drei Säcken nebeneinander nur die
     Oberkanten. Jede weitere Lage liegt 11 höher. Die aufrechten sind auf
     vier Fünftel verkleinert, sonst ragte der Stapel links über das
     Oberdeck. */
  const STAPEL = { lage: 103, stufe: 11, aufrecht: 0.8 };

  function faehreStapel() {
    const lage = (n) => STAPEL.lage - n * STAPEL.stufe;
    const mass = STAPEL.aufrecht;
    const links = [14, 48, 82].map(x => faehreSack(x, lage(0))).join('') +
      [31, 65].map(x => faehreSack(x, lage(1))).join('') +
      faehreSackAufrecht(38.5, 'CAFÉ DO', 'BRASIL', { unten: lage(1) + 1, mass, kipp: 2, rahmen: 'rechteck' }) +
      faehreSackAufrecht(64.5, 'CAFÉ DE', 'COLOMBIA', { unten: lage(1) + 1, mass, kipp: -2, rahmen: 'oval' });
    const rechts = [386, 420, 454].map(x => faehreSack(x, lage(0))).join('') +
      faehreSack(437, lage(1)) +
      faehreSackAufrecht(411, 'GUJI', 'ETHIOPIA', { unten: lage(0) + 1, mass, kipp: 2, rahmen: 'linien' });
    return links + rechts;
  }

  /* --- Ladung 'haufen': Beutel mit echten Etiketten ----------------------
     Auf jedem Deck ein Haufen aus bwBeutel() (beutel.js, aus dem CI-Guide:
     der Rohling mit dem Etikett, wie es gedruckt ist). Links zehn, oben
     drauf steht ordentlich gerade der Apas FT Blend. Rechts sieben, die
     Spitze ist der Finca Hoyo Frío Filterkaffee, schräg wie der Rest.

     bwBeutel misst 86 × 90 und steht auf ein Drittel verkleinert, so gross
     wie die Beutel von 'beutel'. Die Unterkante liegt bei y 118 hinter der
     Bordwand. Seine Striche wären verkleinert halb so stark wie der Rest
     der Fähre, faehren.css zieht sie über .haufen-beutel nach.

     Die unterste Reihe steht im Abstand von 56 Beutel-Einheiten, jede
     höhere liegt gleichmässig in den Lücken der Reihe darunter. Drehung
     und Versatz sind die festen Werte aus positionen() in beutel.js, ein
     Haufen sieht also immer gleich aus. Der ordentliche Beutel steht auf
     den Oberkanten der Reihe darunter und taucht nur ein Viertel ein.

     Die Etiketten wechseln ab, anders als im Kennzahlenbericht, wo ein
     Haufen eine Röstung ist: Kein Beutel trägt dieselbe Etikettfarbe wie
     einer, den er berührt (nächste oder gleiche Reihe, Mitten weniger als
     eine Beutelbreite auseinander). Der Vorrat geht reihum durch die
     Sorten, mit Schritt 3, ohne die Spitze. Gesucht wird mit Zurücksetzen,
     erst mit jeder Sorte einmal, dann zweimal, also immer mit demselben
     Ergebnis. Links geht es einmal nicht auf: Unter dem Apas sind neun
     Plätze, von je vier berühren sich immer mindestens zwei, also passen
     die vier dunkelblauen nicht. Dort liegt der Hoyo Frío Filterkaffee
     zweimal, nicht nebeneinander. Kommt eine Sorte dazu oder fällt eine
     weg, verteilt die Suche neu. */
  const HAUFEN = {
    mass: 0.33, breite: 86, hoehe: 90, boden: 118,
    abstand: 56, reihe: 36, eintauchen: 0.25,
    decks: [
      { mitte: 70,  reihen: [4, 3, 2, 1], spitze: 'Apas FT Blend|Espresso', ordentlich: true,  versatz: 0 },
      { mitte: 430, reihen: [4, 2, 1],    spitze: 'Hoyo Frío|Filter',       ordentlich: false, versatz: 5 }
    ]
  };

  function haufenLage(reihen) {
    const { breite, abstand, reihe: hoch } = HAUFEN;
    const pos = [];
    let unten = [];
    reihen.forEach((k, reihe) => {
      let mitten;
      if (!reihe) {
        mitten = Array.from({ length: k }, (_, j) => (j - (k - 1) / 2) * abstand);
      } else {
        const luecken = unten.slice(1).map((m, i) => (unten[i] + m) / 2);
        const mittig = (luecken[Math.floor((luecken.length - 1) / 2)] +
                        luecken[Math.ceil((luecken.length - 1) / 2)]) / 2;
        mitten = Array.from({ length: k }, (_, j) =>
          k === 1 ? mittig : luecken[Math.round(j * (luecken.length - 1) / (k - 1))]);
      }
      mitten.forEach((mitte) => {
        const i = pos.length;
        pos.push({
          reihe, mitte,
          x: mitte - breite / 2 + ((i * 53 + 5) % 9 - 4) * 1.2,
          y: reihe * hoch,
          dreh: ((i * 37 + 11) % 15 - 7) * 1.1
        });
      });
      unten = mitten;
    });
    return pos;
  }

  function haufenEtiketten(pos, versatz) {
    const etiketten = global.BW_ETIKETTEN;
    const sorten = Object.keys(etiketten);
    const grund = (art) => etiketten[art].grund;
    const fest = pos.filter(p => p.art).map(p => p.art);
    const reihum = [];
    for (let i = 0; i < sorten.length; i++) {
      const art = sorten[(versatz + i * 3) % sorten.length];
      if (!fest.includes(art)) reihum.push(art);
    }
    const frei = pos.filter(p => !p.art);

    const nah = new Map(pos.map(p => [p, pos.filter(q => q !== p &&
      Math.abs(q.reihe - p.reihe) <= 1 && Math.abs(q.mitte - p.mitte) < HAUFEN.breite)]));
    const nachbarn = (p) => nah.get(p).map(q => q.art).filter(Boolean);
    const farbeFrei = (p, art) => nachbarn(p).every(n => grund(n) !== grund(art));
    const sorteFrei = (p, art) => nachbarn(p).every(n => n !== art);

    let vorrat, schritte;
    function setzen(i) {
      if (i === frei.length) return true;
      if (++schritte > 20000) return false;
      const p = frei[i], versucht = new Set();
      for (let v = 0; v < vorrat.length; v++) {
        const art = vorrat[v];
        if (versucht.has(art) || !farbeFrei(p, art)) continue;
        versucht.add(art);
        vorrat.splice(v, 1);
        p.art = art;
        if (setzen(i + 1)) return true;
        p.art = null;
        vorrat.splice(v, 0, art);
      }
      return false;
    }

    const einmal = Math.ceil(frei.length / reihum.length);
    for (const runden of [einmal, einmal + 1]) {
      vorrat = Array.from({ length: runden }, () => reihum).flat();
      schritte = 0;
      if (setzen(0)) return pos;
    }
    // Geht es mit den Farben gar nicht auf: der Reihe nach, was passt,
    // zuletzt nur verschiedene Sorten.
    frei.forEach((p) => {
      let v = vorrat.findIndex(art => farbeFrei(p, art));
      if (v < 0) v = vorrat.findIndex(art => sorteFrei(p, art));
      if (v < 0) v = 0;
      p.art = vorrat.splice(v, 1)[0];
    });
    return pos;
  }

  function haufenBeutel(p, mitte) {
    const { mass, breite, hoehe, boden } = HAUFEN;
    const x = mitte + p.x * mass;
    const y = boden - (p.y + hoehe) * mass;
    const dreh = p.dreh ? ` rotate(${p.dreh.toFixed(1)} ${breite / 2} ${hoehe / 2})` : '';
    return `<g class="haufen-beutel${p.ordentlich ? ' haufen-beutel--ordentlich' : ''}"
               transform="translate(${x.toFixed(1)} ${y.toFixed(1)}) scale(${mass})${dreh}">${
      global.bwBeutel(p.art, '/')}</g>`;
  }

  function faehreHaufen() {
    const { breite, hoehe, reihe, eintauchen } = HAUFEN;
    return HAUFEN.decks.map((deck) => {
      const pos = haufenLage(deck.reihen);
      const oben = pos[pos.length - 1];
      oben.art = deck.spitze;
      if (deck.ordentlich && pos.length > 1) {
        oben.x = oben.mitte - breite / 2;
        oben.dreh = 0;
        oben.y = (oben.reihe - 1) * reihe + hoehe * (1 - eintauchen);
        oben.ordentlich = true;
      }
      haufenEtiketten(pos, deck.versatz);
      return `<g class="haufen">${pos.map(p => haufenBeutel(p, deck.mitte)).join('')}</g>`;
    }).join('');
  }

  // Quadratisch, das Kreuz nach der Bundesvorgabe: Balken 6/32 breit,
  // insgesamt 20/32 lang. Der Grund in Redorange statt Schweizer Rot, auf
  // Wunsch in der Hausfarbe.
  function schweizerFlagge(x, y, s) {
    const b = s * 6 / 32;
    const e = s * 20 / 32;
    return `<rect x="${x}" y="${y}" width="${s}" height="${s}" fill="${F.signal}"/>
            <rect x="${x + (s - b) / 2}" y="${y + (s - e) / 2}" width="${b}" height="${e}" fill="#FFFFFF"/>
            <rect x="${x + (s - e) / 2}" y="${y + (s - b) / 2}" width="${e}" height="${b}" fill="#FFFFFF"/>`;
  }

  function dunkelblaueFlagge(x, y, s) {
    return `<rect x="${x}" y="${y}" width="${s}" height="${s}" fill="${F.kontur}"/>`;
  }

  // 'saecke', 'beutel' und 'autos' bauen beide Decks gleich auf, wie es sich
  // für einen Doppelender gehört. 'stapel' und 'haufen' sind je Deck
  // verschieden, siehe oben.
  function faehreLadung(ladung) {
    if (ladung === 'stapel') return faehreStapel();
    if (ladung === 'haufen') {
      if (global.bwBeutel && global.BW_ETIKETTEN) return faehreHaufen();
      ladung = 'beutel';
    }
    if (ladung === 'saecke') {
      // Aussen ein liegender Stapel, zwei unten und einer oben, daneben am
      // Aufbau ein aufrechter Sack mit der Herkunft. Rechts gespiegelt.
      const stapel = [[16, 106], [50, 106], [33, 95]];
      return stapel.map(([x, y]) => faehreSack(x, y) + faehreSack(gespiegelt(x, 32), y)).join('') +
             faehreSackAufrecht(90, 'CAFÉ DO', 'BRASIL') +
             faehreSackAufrecht(gespiegelt(90, 30), 'CAFÉ DE', 'COLOMBIA');
    }
    if (ladung === 'beutel') {
      // Drei tragen die Etiketten echter Kaffees, drei das Standard-Dunkelblau.
      const links = [[14, 'standard'], [48, 'hoyoEspresso'], [82, 'standard']];
      const rechts = [[386, 'hoyoFilter'], [420, 'standard'], [454, 'megaduFilter']];
      return [...links, ...rechts].map(([x, art]) => faehreBeutel(x, art)).join('');
    }
    return faehreAuto(20, F.eis) + faehreAuto(68, '#FFC000') +
           faehreAuto(392, '#E7455B') + faehreAuto(440, F.signal);
  }

  function faehreFenster(xs, y, b, h) {
    return xs.map(x => `<rect x="${x}" y="${y}" width="${b}" height="${h}" rx="1.4"/>`).join('');
  }

  function bwFaehre(o) {
