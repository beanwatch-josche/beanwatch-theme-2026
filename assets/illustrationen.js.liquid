            fill="${farbe || 'none'}" stroke="${H}" stroke-width="2"/>
      <path d="M${x + 6.5} ${y + 3} V${y + 12} M${x + 12.5} ${y + 3} V${y + 12}"
            stroke="${H}" stroke-width="1.4" opacity=".45"/>
    </g>`;
